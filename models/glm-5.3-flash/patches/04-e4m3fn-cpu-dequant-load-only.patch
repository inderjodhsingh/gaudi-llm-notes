+def _e4m3fn_bits_to_cpu(t: torch.Tensor) -> torch.Tensor:
+    """Bit-copy float8_e4m3fn to CPU without Gaudi2 exp=15 Inf/NaN rewrite.
+
+    Gaudi2's e4m3fn decoder turns exp=15 lanes into Inf/NaN. Copy via uint8
+    so the IEEE bits are preserved, then view as float8_e4m3fn on CPU.
+    Must run before ``.to("hpu")`` of e4m3fn; a later bit-copy from HPU is
+    already dead. Non-e4m3fn tensors are just moved to CPU.
+    """
+    if not torch.is_tensor(t):
+        return t
+    if t.dtype != torch.float8_e4m3fn:
+        return t.detach().to("cpu") if t.device.type != "cpu" else t.detach()
+    u8 = t.detach().contiguous().view(torch.uint8)
+    if u8.device.type != "cpu":
+        u8 = u8.cpu()
+    return u8.view(torch.float8_e4m3fn)
+
+
