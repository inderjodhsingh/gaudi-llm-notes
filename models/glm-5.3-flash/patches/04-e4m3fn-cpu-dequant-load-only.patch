+def _glm53_dump_loaded_tensors(runner) -> None:
+    """Phase 1 gate artifact: per-rank tensor manifest + HBM, then the caller exits."""
+    import json
+    from collections import Counter
+
+    rank = 0
+    try:
+        rank = get_tensor_model_parallel_rank()
+    except Exception:
+        rank = int(os.environ.get("RANK", "0"))
+    out_dir = os.environ.get("GLM53_LOAD_DUMP_DIR", "/work/logs")
+    os.makedirs(out_dir, exist_ok=True)
+
+    tensors = []
+    dtype_counts: Counter[str] = Counter()
+    nbytes = 0
+    for name, p in runner.model.named_parameters():
+        t = p.detach()
+        dt = str(t.dtype).replace("torch.", "")
+        n = int(t.numel()) * (t.element_size() if t.dtype != torch.float8_e4m3fn else 1)
+        tensors.append({
+            "name": name,
+            "dtype": dt,
+            "shape": list(t.shape),
+            "device": str(t.device),
+            "numel": int(t.numel()),
+        })
+        dtype_counts[dt] += 1
+        nbytes += n
+
+    hbm_alloc = None
+    hbm_max = None
+    try:
+        hbm_alloc = int(torch.hpu.memory_allocated())
+        hbm_max = int(torch.hpu.max_memory_allocated())
+    except Exception:
+        pass
+    profiler_gb = None
+    try:
+        profiler_gb = float(runner.model_memory_usage) / float(2**30)
+    except Exception:
+        pass
+
+    loaded = None
+    for obj in (runner.model, getattr(runner.model, "language_model", None)):
+        if obj is None:
+            continue
+        loaded = getattr(obj, "_glm53_loaded_params", None)
+        if loaded:
+            break
+
+    payload = {
+        "rank": rank,
+        "n_params": len(tensors),
+        "n_loaded_keys": len(loaded) if loaded is not None else None,
+        "dtype_counts": dict(dtype_counts),
+        "param_nbytes": nbytes,
+        "param_gib": nbytes / float(2**30),
+        "hbm_alloc_bytes": hbm_alloc,
+        "hbm_alloc_gib": None if hbm_alloc is None else hbm_alloc / float(2**30),
+        "hbm_max_bytes": hbm_max,
+        "hbm_max_gib": None if hbm_max is None else hbm_max / float(2**30),
+        "profiler_consumed_gib": profiler_gb,
+        "model": getattr(runner.model_config, "model", None),
+        "tensors": tensors,
+        "loaded_keys": sorted(loaded) if loaded is not None else None,
+    }
+    path = os.path.join(out_dir, f"loaded_tensors.rank{rank}.json")
+    with open(path, "w") as f:
+        json.dump(payload, f)
+    logger.info(
+        "GLM53_LOAD_ONLY dump %s params=%d dtypes=%s hbm_alloc_GiB=%.2f profiler_GiB=%s",
+        path,
+        len(tensors),
+        dict(dtype_counts),
+        (hbm_alloc or 0) / float(2**30),
+        None if profiler_gb is None else f"{profiler_gb:.2f}",
+    )
+
