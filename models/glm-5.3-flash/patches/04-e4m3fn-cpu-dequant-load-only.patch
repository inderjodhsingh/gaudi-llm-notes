+        if weight_scale is not None:
+            weight_scale = weight_scale.detach().to("cpu")
     if weight_scale is None:
-        return weight
+        out = weight.to(dtype)
+        return out.to(orig_device) if out.device != orig_device else out
     if weight_scale.device != weight.device:
