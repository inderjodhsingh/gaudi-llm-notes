From ca7faefb904bcc437cb018eeeacb913c9944ff7d Mon Sep 17 00:00:00 2001
From: Gaudi port <gaudi-port@users.noreply.github.com>
Date: Sun, 13 Sep 2026 13:55:18 +0000
Subject: [PATCH] HPU KDA decode: pass query_start_loc into causal conv update

hpu_causal_conv1d_fn_update unpacks 3-D x; without qsl the flatten
path returns 2-D and crashes (expected 3, got 2).
---
 vllm_gaudi/models/glm5next_kda.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/vllm_gaudi/models/glm5next_kda.py b/vllm_gaudi/models/glm5next_kda.py
index 7ba111a..1bbb008 100644
--- a/vllm_gaudi/models/glm5next_kda.py
+++ b/vllm_gaudi/models/glm5next_kda.py
@@ -81,6 +81,8 @@ class HPUGlm5NextLinearAttention(Glm5NextLinearAttention):
         state_indices = self._resolve_state_indices(attn_metadata)
         conv_state, ssm_state = self.kv_cache[0], self.kv_cache[1]
         query_start_loc = getattr(attn_metadata, "query_start_loc_p", None)
+        if query_start_loc is None:
+            query_start_loc = getattr(attn_metadata, "query_start_loc", None)
         if query_start_loc is None:
             query_start_loc = getattr(attn_metadata, "non_spec_query_start_loc", None)
         has_initial_state = getattr(attn_metadata, "has_initial_states_p", None)
@@ -176,6 +178,11 @@ class HPUGlm5NextLinearAttention(Glm5NextLinearAttention):
             core = _save_kda_state(core, final_state, ssm_state, state_indices)
             core = core.reshape(-1, self.local_num_heads, self.head_dim)
         else:
+            qsl = query_start_loc
+            if qsl is None:
+                qsl = torch.arange(
+                    qkv.size(0) + 1, device=qkv.device, dtype=torch.int32
+                )
             mixed = hpu_causal_conv1d_update(
                 x=qkv,
                 conv_state=conv_state,
@@ -185,6 +192,7 @@ class HPUGlm5NextLinearAttention(Glm5NextLinearAttention):
                 conv_state_indices=(
                     state_indices[:num_decodes] if state_indices is not None else state_indices
                 ),
+                query_start_loc=qsl,
             )
             q, k, v = mixed.split(self.local_projection_size, dim=-1)
             q = q.reshape(1, -1, self.local_num_heads, self.head_dim)
-- 
