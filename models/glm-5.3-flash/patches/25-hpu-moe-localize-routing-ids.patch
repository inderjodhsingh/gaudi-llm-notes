From 09bdae334cc64ff1d389ee3d9bf9724c5b5bec83 Mon Sep 17 00:00:00 2001
From: Gaudi port <gaudi-port@users.noreply.github.com>
Date: Sun, 13 Sep 2026 16:48:25 +0000
Subject: [PATCH] HPU MoE: rebase routing ids to local expert slots before
 mixture_of_experts

Habana SW 1.24.1 mixture_of_experts indexes w12/w3 by the raw routing id
and ignores the experts_min offset (ids above experts_max are dropped).
With EP every rank with experts_min != 0 read wrong/out-of-range experts;
GLM-5.3-Flash EP=8 layer 3 only had rank 0's experts right (per-rank
probe: local ids + [0,n-1] match CPU to 3-8%, global ids rel err ~1.0).
Local ids with [0, n_local-1] are equivalent under the documented
global-id contract, so this is safe on both behaviours.
---
 vllm_gaudi/extension/ops.py | 65 +++++++++++++++++++++++++++----------
 1 file changed, 48 insertions(+), 17 deletions(-)

diff --git a/vllm_gaudi/extension/ops.py b/vllm_gaudi/extension/ops.py
index 85b78bf..987aacd 100644
--- a/vllm_gaudi/extension/ops.py
+++ b/vllm_gaudi/extension/ops.py
@@ -656,6 +656,29 @@ class MoeMatmul(torch.nn.Module):
         raise NotImplementedError()
 
 
+
+
+def _localize_routing_ids(routing_ids, experts_min, experts_max, global_num_experts=None):
+    """Rebase global expert ids to this rank's local weight slots.
+
+    Habana SW 1.24.1: ``torch.ops.hpu.mixture_of_experts`` indexes ``w12``/``w3``
+    by the raw routing id and does not subtract ``experts_min`` (ids above
+    ``experts_max`` are dropped). With expert parallelism every rank with
+    ``experts_min != 0`` therefore read the wrong / out-of-range expert slot
+    (GLM-5.3-Flash EP=8: only rank 0's experts were correct). Passing local ids
+    with the range ``[0, n_local-1]`` is equivalent under the documented
+    global-id contract and correct under the observed one. Non-local ids are
+    mapped to ``global_num_experts`` (above any local range) so the kernel
+    drops them.
+    """
+    if experts_min == 0:
+        return routing_ids, experts_min, experts_max
+    n_local = experts_max - experts_min + 1
+    sentinel = max(int(global_num_experts or 0), n_local)
+    keep = (routing_ids >= experts_min) & (routing_ids <= experts_max)
+    local = torch.where(keep, routing_ids - experts_min, torch.full_like(routing_ids, sentinel))
+    return local, 0, n_local - 1
+
 class VllmMixtureOfExpertsOpBase(torch.nn.Module):
 
     def __init__(self,
