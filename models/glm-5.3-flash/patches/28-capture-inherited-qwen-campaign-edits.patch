     )
 
 
+@torch._dynamo.disable
+def hpu_spec_chain_recurrent(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    initial_state: torch.Tensor,
+    ssm_state_indices: torch.Tensor,
+    q_steps: int = 2,
+    use_qk_l2norm_in_kernel: bool = True,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Unroll q=2 single-token GDN steps (k=1 verify). q_steps is ignored; unroll is literal 2.
+
+    q/k/v: [1, R*2, H, dim]. Returns (out [1, R*2, HV, V], new_state [R, ...], sidx).
+    """
+    del q_steps
+    _, _, H, Kdim = q.shape
+    _, _, HV, Vdim = v.shape
+    scale = Kdim**-0.5
+    if H != HV:
+        if HV % H != 0:
+            raise ValueError(f"GDN spec chain: HV={HV} not divisible by H={H}")
+        repeat = HV // H
+        q = q.repeat_interleave(repeat, dim=2)
+        k = k.repeat_interleave(repeat, dim=2)
+        H = HV
+    # MAX_SEQS=1, k=1: force exactly 2 tokens, 1 request. cat then [:, :2]
+    # is a constant slice; no T/q, no R from padded T.
+    q = torch.cat((q, q[:, -1:]), dim=1)[:, :2]
+    k = torch.cat((k, k[:, -1:]), dim=1)[:, :2]
+    v = torch.cat((v, v[:, -1:]), dim=1)[:, :2]
+    g = torch.cat((g, g[:, -1:]), dim=1)[:, :2]
+    beta = torch.cat((beta, beta[:, -1:]), dim=1)[:, :2]
+    q4 = q.to(_GDN_COMPUTE_DTYPE)
+    k4 = k.to(_GDN_COMPUTE_DTYPE)
+    v4 = v.to(_GDN_COMPUTE_DTYPE)
+    g4 = g.to(torch.float32)
+    b4 = beta.to(_GDN_COMPUTE_DTYPE)
+    R = 1
+    if use_qk_l2norm_in_kernel:
+        q4 = _l2norm_last_dim(q4)
+        k4 = _l2norm_last_dim(k4)
+    num_slots = initial_state.shape[0]
+    sidx = torch.remainder(
+        ssm_state_indices.to(initial_state.device).reshape(-1).long()[:1], num_slots)
+    h = initial_state.index_select(0, sidx).to(_GDN_COMPUTE_DTYPE)
+    outs = []
+    for j in range(2):  # literal unroll
