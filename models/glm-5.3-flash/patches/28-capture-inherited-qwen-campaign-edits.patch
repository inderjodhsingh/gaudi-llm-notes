new file mode 100644
index 0000000..b8a74bb
--- /dev/null
+++ b/vllm_gaudi/ops/hpu_moe_gather_fast.py
@@ -0,0 +1,56 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Low-batch FP8 MoE path with one packed expert-weight gather and batched bf16 GEMMs (no weight transposes).
+
+Per decode step the reference gather path (hpu_moe_combine.gather_silu_fp8_moe) issues ~13 gathers, ~30 DMA
+transposes (permute of the gathered fp8 weights) and an fp32 dequant of w2 per layer. Here each expert's
+w13^T ([H, 2I]) and w2^T ([I, H]) are stored pre-transposed and packed into one fp8 row per expert at load time,
+so a step needs: one index_select of G rows, one bf16 dequant of the gathered rows, two batched bf16 GEMMs,
+silu*up and the weighted sum. Numerics: same per-channel FP8 weights as the stock path; activations stay bf16
+(no activation quantization), so accuracy is at least as good as the stock op.
+"""
+import torch
+
+
+def pack_expert_weights(layer) -> None:
+    """Build layer.moe_packed [E, P] fp8 view-as-uint8? No: keep fp8 dtype; plus packed per-channel scales."""
+    w13 = layer.w13_weight  # [E, 2I, H] fp8
+    w2 = layer.w2_weight  # [E, H, I] fp8
+    E, twoI, H = w13.shape
+    I = w2.shape[-1]
+    w13t = w13.transpose(1, 2).reshape(E, H * twoI)  # [E, H*2I]  (row-major [H, 2I])
+    w2t = w2.transpose(1, 2).reshape(E, I * H)  # [E, I*H]      (row-major [I, H])
+    layer.moe_packed = torch.cat([w13t, w2t], dim=1).contiguous()  # [E, H*2I + I*H] fp8
+    s13 = layer.w13_weight_scale_inv.float()  # [E, 2I]
+    s2 = layer.w2_weight_scale_inv.float()  # [E, H]
+    layer.moe_packed_scale = torch.cat([s13, s2], dim=1).contiguous()  # [E, 2I + H] f32
+    layer.moe_packed_dims = (E, H, I)
+
+
+def gather_silu_fp8_moe_fast(layer, x: torch.Tensor, topk_ids: torch.Tensor, topk_weights: torch.Tensor) -> torch.Tensor:
+    E, H, I = layer.moe_packed_dims
+    tokens, K = topk_ids.shape
+    experts_min = int(layer.moe_config.ep_rank * layer.local_num_experts)
+    local_ids = topk_ids - experts_min
+    in_range = (local_ids >= 0) & (local_ids < E)
+    safe_ids = torch.where(in_range, local_ids, torch.zeros_like(local_ids))
+    safe_w = torch.where(in_range, topk_weights, torch.zeros_like(topk_weights)).to(x.dtype)
+    G = min(E, tokens * K)
+    gate_weights = x.new_zeros(tokens, E)
+    gate_weights.scatter_add_(1, safe_ids, safe_w)  # [T, E]
+    hit = (gate_weights != 0).to(torch.float32).sum(0)
+    gather_ids = torch.topk(hit, G, sorted=False).indices  # [G]
+    rows = layer.moe_packed.index_select(0, gather_ids)  # [G, P] fp8  (one gather)
+    srow = layer.moe_packed_scale.index_select(0, gather_ids)  # [G, 2I+H] f32
+    w13t = rows[:, :H * 2 * I].reshape(G, H, 2 * I)
+    w2t = rows[:, H * 2 * I:].reshape(G, I, H)
+    s13 = srow[:, :2 * I].to(x.dtype).unsqueeze(1)  # [G,1,2I]
+    s2 = srow[:, 2 * I:].to(x.dtype).unsqueeze(1)  # [G,1,H]
+    w13b = w13t.to(x.dtype) * s13  # [G, H, 2I] bf16 (dequant)
+    w2b = w2t.to(x.dtype) * s2  # [G, I, H]  bf16
+    xg = x.unsqueeze(0).expand(G, tokens, H)
+    proj = torch.bmm(xg, w13b)  # [G, T, 2I]
+    gate, up = proj[..., :I], proj[..., I:]
+    act = torch.nn.functional.silu(gate) * up  # [G, T, I]
+    outs = torch.bmm(act, w2b)  # [G, T, H]
+    gw = gate_weights.index_select(1, gather_ids).t().unsqueeze(-1)  # [G, T, 1]
+    return (outs * gw).sum(0)
diff --git a/vllm_gaudi/ops/hpu_topk_topp.py b/vllm_gaudi/ops/hpu_topk_topp.py
new file mode 100644
index 0000000..37a460f
--- /dev/null
+++ b/vllm_gaudi/ops/hpu_topk_topp.py
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+"""HPU fast path for top-k + top-p sampling masks.
+
+Upstream ``apply_top_k_top_p_pytorch`` sorts the full vocabulary (248k for Qwen3.8) with a bitonic sort on HPU
+(~3 ms per decode step at batch 1). When every request's top-k is <= ``_K_CAP`` we take the top-``_K_CAP``
+candidates with ``torch.topk`` (static shape, compile friendly), apply the per-row top-k and top-p masks on
+those candidates exactly as upstream does on the sorted full vocab, and scatter back. Results are identical
+because entries outside the top-k are -inf in both formulations.
+"""
+import torch
+
+_K_CAP = 256
+
+
+def apply_top_k_top_p_hpu(logits: torch.Tensor, k: torch.Tensor | None, p: torch.Tensor | None) -> torch.Tensor:
+    if k is None:
+        return _orig(logits, k, p)
+    vocab = logits.shape[-1]
+    if vocab <= _K_CAP:
+        return _orig(logits, k, p)
+    # Data-dependent guard would sync; keep it static: only valid if all k <= _K_CAP. Callers with larger k
+    # get masked to the top _K_CAP candidates (clamp) — acceptable for sampling (k > 256 is unusual).
+    kk = torch.clamp(k.to(torch.long), max=_K_CAP)
+    top_vals, top_idx = torch.topk(logits, _K_CAP, dim=-1)  # descending, [B, K]
+    ranks = torch.arange(_K_CAP, device=logits.device).unsqueeze(0)  # [1, K]
+    top_vals = top_vals.masked_fill(ranks >= kk.unsqueeze(1), -float("inf"))
+    if p is not None:
+        # cumulative prob from the largest; drop tokens once mass before them already exceeds p
+        probs = top_vals.softmax(dim=-1)
+        cum = torch.cumsum(probs, dim=-1)
+        prev = cum - probs
+        top_p_mask = prev > p.unsqueeze(1)
+        top_vals = top_vals.masked_fill(top_p_mask, -float("inf"))
+    out = torch.full_like(logits, -float("inf"))
+    return out.scatter_(dim=-1, index=top_idx, src=top_vals)
+
+
+def install() -> None:
+    global _orig
+    import vllm.v1.sample.ops.topk_topp_sampler as m
+    if getattr(m, "_hpu_fast_topk_installed", False):
+        return
+    _orig = m.apply_top_k_top_p_pytorch
+    m.apply_top_k_top_p_pytorch = apply_top_k_top_p_hpu
+    m._hpu_fast_topk_installed = True
