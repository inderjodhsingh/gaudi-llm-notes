@@ -487,3 +487,38 @@ def hpu_causal_conv1d_fn_update(
         conv_states[safe_cache_idx, -state_len:, :] = new_state.transpose(-1, -2)
 
     return out.to(original_dtype)
+
+
+# k=1 verify: q=k+1=2. MUST be a Python literal so dynamo never sees T/q (s47//(s47//2)).
+_SPEC_Q_K1 = 2
+
+
+@torch._dynamo.disable
+def hpu_spec_chain_conv_update(
+    x: torch.Tensor,
+    conv_state: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    activation: bool | str | None,
+    state_indices: torch.Tensor,
+    q_steps: int = _SPEC_Q_K1,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Causal conv for flattened spec rows [R*2, C], k=1. Does not write cache.
+
+    Returns (out [R*2, C], new_state [R, state_len, C], idx).
+    """
+    del q_steps  # unused; keep signature. Unroll uses literal 2.
+    activation = _normalize_activation(activation)
+    C = weight.size(0)
+    work_dtype = conv_state.dtype
+    x = torch.cat((x, x[-1:]), dim=0)[:2]
+    xq = x.reshape(1, 2, C).to(work_dtype).transpose(1, 2)  # [1, C, 2]
+    idx = torch.remainder(state_indices.to(conv_state.device).reshape(-1).long()[:1], conv_state.shape[0])
+    st = conv_state.index_select(0, idx).to(work_dtype).transpose(-1, -2)  # [R, C, S]
+    seq = torch.cat([st, xq], dim=2)
+    out = _depthwise_conv1d_tpc(seq, weight.to(work_dtype), None if bias is None else bias.to(work_dtype))
+    out = _apply_activation(out, activation)
+    new_state = seq[:, :, -st.size(2):].transpose(-1, -2).contiguous()
+    return out.transpose(1, 2).reshape(-1, C).to(x.dtype), new_state, idx
+
+
