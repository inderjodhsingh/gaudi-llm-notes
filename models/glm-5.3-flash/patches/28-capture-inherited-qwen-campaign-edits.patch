+class _LayerGroup(nn.Module):
+    """Runs a fixed list of decoder layers; compiled as one region (layers unregistered on purpose)."""
+
+    def __init__(self, layers: list) -> None:
+        super().__init__()
+        self._group_layers = layers
+
+    def forward(self, hidden_states, positions, input_ids, state_writes):
+        for layer in self._group_layers:
+            hidden_states = layer(hidden_states, positions, input_ids, state_writes)
+        return hidden_states
+
+
+class _CommitRegion(nn.Module):
+    """Applies pending recurrent state writes as their own compiled region (prior hybrid-state design).
+
+    For spec-decode rollback: snapshots stay region outputs; this module
+    index_copy_s the accepted snapshot into the cache after the rejection sampler.
+    """
+
+    def forward(self, hidden_states, writes):
+        for (state, idx, val) in writes:
+            state.index_copy_(0, idx, val)
+        return hidden_states
+
+
+class HpuQwen4ExpModel(nn.Module):
+    hf_to_vllm_mapper = Qwen3_5Model.hf_to_vllm_mapper
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__()
+        config: Qwen4ExpTextConfig = vllm_config.model_config.hf_text_config
+        self.config = config
+        self.vocab_size = config.vocab_size
+        self.hc_count = int(config.hc_count)
+        self.embed_tokens = VocabParallelEmbedding(self.vocab_size, config.hidden_size)
+
+        def get_layer(prefix: str) -> HpuQwen4ExpDecoderLayer:
+            layer_idx = extract_layer_index(prefix)
+            return HpuQwen4ExpDecoderLayer(vllm_config, layer_type=config.layer_types[layer_idx], prefix=prefix)
+
+        self.start_layer, self.end_layer, self.layers = make_layers(config.num_hidden_layers, get_layer,
+                                                                    prefix=f"{prefix}.layers")
+        # Group consecutive layers into modules so the runner's regional compilation (one region per
+        # ModuleList child) compiles G layers as a single graph. Groups keep the layer modules in a plain
+        # list (unregistered) so parameter names / weight loading stay on ``self.layers``.
+        G = max(1, _LAYERS_PER_REGION)
+        # Runner regional compilation must NOT compile individual layers (they would
+        # run as nested dynamo frames inside the group regions: one cache lookup per layer).
+        self.layers._no_regional_compile = True
+        real_layers = list(self.layers)[self.start_layer:self.end_layer]
+        self.layer_groups = nn.ModuleList(
+            [_LayerGroup(real_layers[i:i + G]) for i in range(0, len(real_layers), G)])
+        self.make_empty_intermediate_tensors = make_empty_intermediate_tensors_factory(
+            ["hidden_states"], config.hidden_size * config.hc_count)
+        hc_config = HyperConnectionConfig(hc_count=config.hc_count, hidden_size=config.hidden_size,
+                                          params_dtype=torch.bfloat16, hc_lowrank=config.hc_lowrank,
+                                          rms_norm_eps=config.rms_norm_eps, hc_per_branch_norm=True)
+        self.hyper_connection_mixer = GatedResidual(hc_config, use_combine=False)
+        self.commit_region = _CommitRegion()
+        spec = vllm_config.speculative_config
+        HPUGatedDeltaNetAttention.spec_q = 1 + (int(spec.num_speculative_tokens) if spec else 0)
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.embed_tokens(input_ids)
+
+    def forward(self, input_ids: torch.Tensor | None, positions: torch.Tensor,
+                intermediate_tensors: IntermediateTensors | None = None,
+                inputs_embeds: torch.Tensor | None = None, **kwargs) -> torch.Tensor:
+        if inputs_embeds is not None:
+            hidden_states = inputs_embeds
+        else:
+            if input_ids is None:
+                raise ValueError("input_ids or inputs_embeds is required")
+            hidden_states = self.embed_input_ids(input_ids)
+        rep = [1] * (hidden_states.dim() - 1) + [self.hc_count]
+        hidden_states = hidden_states.repeat(*rep)
+
+        if _DEBUG:
+            _dbg("embed", hidden_states, input_ids)
+            md = get_forward_context().attn_metadata
+            _dbg("meta", getattr(md, "load_indices_tensor", None) if md is not None else None,
+                 getattr(md, "has_initial_states_p", None) if md is not None else None,
+                 getattr(md, "query_start_loc_p", None) if md is not None else None)
+            for li in (0, 1):
+                lyr = self.layers[li]
+                if getattr(lyr, "ple", None) is not None and len(lyr.ple.kv_cache) == 2:
+                    _dbg(f"state.ple{li}", lyr.ple.kv_cache[0], lyr.ple.kv_cache[1])
+                if hasattr(lyr, "linear_attn") and len(lyr.linear_attn.kv_cache) == 2:
+                    _dbg(f"state.gdn{li}", lyr.linear_attn.kv_cache[0], lyr.linear_attn.kv_cache[1])
+        if _DEBUG:
+            for i, layer in enumerate(islice(self.layers, self.start_layer, self.end_layer)):
+                hidden_states = layer(hidden_states, positions, input_ids)
+                if i < 4 or i % 8 == 7 or i == self.end_layer - 1:
+                    _dbg(f"layer{i}", hidden_states)
+        else:
+            # Eager: one get_forward_context per step so compiled groups do not graph-break per layer.
+            HPUGatedDeltaNetAttention._step_md = get_forward_context().attn_metadata
+            try:
+                for group in self.layer_groups:
+                    state_writes: list = []
+                    hidden_states = group(hidden_states, positions, input_ids, state_writes)
+                    if state_writes:
+                        hidden_states = self.commit_region(hidden_states, state_writes)
+            finally:
+                HPUGatedDeltaNetAttention._step_md = None
+
+        sample_hidden_states, _ = self.hyper_connection_mixer.mix(hidden_states)
+        if _DEBUG: _dbg("final", sample_hidden_states)
+        return sample_hidden_states
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        weights = maybe_fuse_shared_experts(weights, enabled=False,
+                                            n_routed_experts=getattr(self.config, "num_experts", 0) or 0,
+                                            n_shared_experts=1, ckpt_prefix="mlp.shared_expert")
+        skip_substrs = ("hashstats_", "token_lookup", "hyper_connection_mixer.block_inject_weight")
+        mapper = self.hf_to_vllm_mapper | WeightsMapper(orig_to_new_substr={s: None for s in skip_substrs})
+        loader = AutoWeightsLoader(self, ignore_unexpected_suffixes=_IGNORED_SUFFIXES.copy())
+        return loader.load_weights(weights, mapper=mapper)
+
