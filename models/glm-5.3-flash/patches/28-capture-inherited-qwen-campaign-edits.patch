@@ -71,7 +71,22 @@ class VLLMKVCache(torch.nn.Module):
     def forward(self, input, cache, slot_mapping, scales=None, block_size=None, is_prompt=False, **kwargs):
         # In cross-attention kv cache forward inputs are None in decode
         # We don't want to store them in the cache in such case
-        if input is not None:
+        if input is not None and slot_mapping is not None:
+            n = slot_mapping.numel()
+            if input.size(0) != n:
+                # Spec-decode verify: HPU packs q=k+1 as extra batch rows while
+                # rotary/mrope can expand dim0 (e.g. 4 vs 2 slots). Align for index_copy_.
+                if input.size(0) > n and input.size(0) % n == 0:
+                    extra = input.size(0) // n
+                    input = input.view(n, extra, *input.shape[1:]).select(1, 0)
+                elif n > input.size(0) and n % input.size(0) == 0:
+                    input = input.repeat_interleave(n // input.size(0), dim=0)
+                else:
+                    raise RuntimeError(
+                        f"KV cache write: slot_mapping n={n} vs input.shape={tuple(input.shape)}"
+                    )
+            cache.index_copy_(0, slot_mapping, input)
+        elif input is not None:
             cache.index_copy_(0, slot_mapping, input)
         return cache
 
