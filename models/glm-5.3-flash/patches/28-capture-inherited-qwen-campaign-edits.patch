+        gf, bf = g4[:, j], b4[:, j]
+        q_s = qf * scale
+        h = h * torch.exp(gf).to(h.dtype).unsqueeze(-1).unsqueeze(-1)
+        proj = torch.matmul(h, kf.unsqueeze(-1)).squeeze(-1)
+        v_new = (vf - proj) * bf.unsqueeze(-1)
+        h = h + v_new.unsqueeze(-1) * kf.unsqueeze(2)
+        outs.append(torch.matmul(h, q_s.unsqueeze(-1)).squeeze(-1))
+    out = torch.stack(outs, dim=1).reshape(1, -1, HV, Vdim).to(v.dtype)
+    return out, h.to(initial_state.dtype), sidx
+
+
