+        self.pre_fc_norm_embedding = GemmaRMSNorm(self.hidden_size, eps=config.rms_norm_eps)
+        self.pre_fc_norm_hidden = GemmaRMSNorm(self.hidden_size * self.hc_count, eps=config.rms_norm_eps)
+        hc_config = HyperConnectionConfig(hc_count=config.hc_count, hidden_size=config.hidden_size,
+                                          params_dtype=torch.bfloat16, hc_lowrank=config.hc_lowrank,
