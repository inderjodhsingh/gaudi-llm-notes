+        return MambaStateShapeCalculator.gated_delta_net_state_shape(tp_size, hf.linear_num_key_heads,
+                                                                     hf.linear_num_value_heads, hf.linear_key_head_dim,
+                                                                     hf.linear_value_head_dim,
+                                                                     hf.linear_conv_kernel_dim, num_spec)
+
+    @classmethod
