@@ -197,6 +197,12 @@ def _patch_habana_symbolic_diagnostics() -> None:
                 except Exception as e:  # pragma: no cover
                     lines.append(f"{node.name}: <{e}>")
             ops = [str(n.target) for n in graph_module.graph.nodes if n.op == "call_function"][:40]
