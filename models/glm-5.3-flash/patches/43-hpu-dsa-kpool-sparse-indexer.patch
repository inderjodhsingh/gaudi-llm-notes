+class HPUKpoolIndexer(nn.Module):
+    """Parameters and projections of the k-pool indexer (names match the checkpoint)."""
+
+    def __init__(self, hidden_size: int, q_lora_rank: int, n_heads: int, head_dim: int, kpool: int, topk: int,
+                 dtype: torch.dtype = torch.bfloat16):
+        super().__init__()
+        self.n_heads, self.head_dim, self.kpool, self.topk_tokens = n_heads, head_dim, kpool, topk
+        self.wq_b = nn.Linear(q_lora_rank, n_heads * head_dim, bias=False, dtype=dtype)
+        self.wk = nn.Linear(hidden_size, head_dim, bias=False, dtype=dtype)
+        self.k_norm = nn.LayerNorm(head_dim, eps=1e-6, dtype=dtype)
+        self.weights_proj = nn.Linear(hidden_size, n_heads, bias=False, dtype=dtype)
+        self.index_kpool_compress_gate = nn.Parameter(torch.zeros(head_dim, hidden_size, dtype=dtype))
+        self.index_kpool_compress_ape = nn.Parameter(torch.zeros(kpool, head_dim, dtype=torch.float32))
+        self.softmax_scale = head_dim**-0.5
+
+    def forward(self, hidden_states: torch.Tensor, q_c: torch.Tensor):
+        """hidden_states [T, hidden], q_c [T, q_lora_rank] (after q_a_layernorm).
+
+        Returns q [T, H, D], kg [T, 2D] (k | gate, the per-token indexer cache row), w [T, H]."""
+        q = self.wq_b(q_c).view(-1, self.n_heads, self.head_dim)
+        k = F.layer_norm(self.wk(hidden_states).float(), (self.head_dim, ), self.k_norm.weight.float(),
+                         self.k_norm.bias.float(), self.k_norm.eps).to(hidden_states.dtype)
+        gate = F.linear(hidden_states, self.index_kpool_compress_gate)
+        w = self.weights_proj(hidden_states)
+        return q, torch.cat([k, gate], dim=-1), w
+
+
+def pool_keys(kg: torch.Tensor, ape: torch.Tensor, kpool: int) -> torch.Tensor:
+    """kg [..., L, 2D] with L a multiple of kpool -> pooled keys [..., L/kpool, D]."""
+    d = kg.shape[-1] // 2
+    k, gate = kg.split(d, dim=-1)
+    lead = k.shape[:-2]
+    p = k.shape[-2] // kpool
+    k4 = k.reshape(*lead, p, kpool, d)
+    g4 = gate.reshape(*lead, p, kpool, d)
+    prob = (g4.float() + ape.float()).softmax(dim=-2).to(k.dtype)
+    return (prob * k4).sum(dim=-2)
+
+
+def index_scores(q: torch.Tensor, pk: torch.Tensor, w: torch.Tensor, scale: float) -> torch.Tensor:
+    """q [..., C, H, D], pk [..., P, D], w [..., C, H] -> [..., C, P] float32 (ReLU-weighted MQA logits)."""
+    h = q.shape[-2]
+    s = torch.matmul(q.float(), pk.float().transpose(-1, -2).unsqueeze(-3))  # [..., C, H, P]
+    s = F.relu(s * scale)
+    wf = (w.float() * (h**-0.5)).unsqueeze(-1)  # [..., C, H, 1]
+    return (wf * s).sum(dim=-2)
+
+
+def prefill_sparse_bias(q: torch.Tensor, kg: torch.Tensor, w: torch.Tensor, ape: torch.Tensor, scale: float,
+                        topk: int, kpool: int, chunk: int = 1024, out_dtype: torch.dtype | None = None) -> torch.Tensor:
+    """Additive attention bias [B, 1, L, L] for bucketed prompts (token t of each sequence at position t).
+
+    q [B, L, H, D], kg [B, L, 2D], w [B, L, H]. Rows of pad queries keep their own token allowed so no
+    row is fully masked (their output is discarded by the caller). Pad keys are never selected by real rows.
     """
