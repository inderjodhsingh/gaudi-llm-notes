@@ -2618,7 +2618,8 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
                                       slot_mapping,
                                       batch_size,
                                       block_size=None,
-                                      force_non_contiguous=False):
+                                      force_non_contiguous=False,
+                                      return_kidx=False):
         """Build paged attention buffers for decode.
 
         Args:
@@ -2631,6 +2632,7 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
         last_block_usage = [slot[0] % block_size + 1 for slot in slot_mapping]
         block_groups = [[i] * len(bt) for i, bt in enumerate(block_tables)]
         block_usage = [[block_size] * (len(bt) - 1) + [lbu] for bt, lbu in zip(block_tables, last_block_usage) if bt]
+        block_kidx = flatten([list(range(len(bt))) for bt in block_tables]) if return_kidx else None
         block_list = flatten(block_tables)
         block_groups = flatten(block_groups)
         block_usage = flatten(block_usage)
@@ -2694,6 +2696,9 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
         block_list = torch.tensor(block_list, dtype=torch.long, device='cpu')
         block_groups = torch.tensor(block_groups, dtype=torch.long, device='cpu')
         block_usage = torch.tensor(block_usage, dtype=self.model_config.dtype, device='cpu')
+        if return_kidx:
+            block_kidx = torch.tensor(padding_fn(block_kidx, 0), dtype=torch.long, device='cpu')
+            return block_list, block_groups, block_usage, block_kidx
         return block_list, block_groups, block_usage
 
     def _align_and_pad_mrope_positions(self, req_ids: list[str], context_lens: list[int], query_lens: list[int],
@@ -3438,13 +3443,25 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
         block_tables_list = self._resolve_all_blocks(block_tables_list)
 
         # CONTEXT_LENS [batch_size]
-        block_list, block_groups, block_usage = \
-            self.get_habana_paged_attn_buffers(
-                block_tables_list,
-                slot_mapping.tolist(),
-                padded_batch_size * num_tokens,
-                block_size=decode_block_size,
-            )
+        dsa_sparse = get_config().dsa_sparse
+        block_kidx = None
+        if dsa_sparse:
+            block_list, block_groups, block_usage, block_kidx = \
+                self.get_habana_paged_attn_buffers(
+                    block_tables_list,
