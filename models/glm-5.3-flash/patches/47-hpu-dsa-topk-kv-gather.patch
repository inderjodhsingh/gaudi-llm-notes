+
+# ---------------------------------------------------------------------------------------------------------------
+# Top-k KV gather (replaces the L x L prefill mask and the per-block decode bias in the serving path).
+# Attention runs in MLA latent space: scores = (q W_UK^T) . c_j and values = W_UV (sum_j a_j c_j), which is the same
+# algebra the HPU MLA decode path already uses, so only the 2051 selected 512-d latents per query are touched.
+# ---------------------------------------------------------------------------------------------------------------
+
+
+def prefill_select_tokens(q: torch.Tensor, pk: torch.Tensor, w: torch.Tensor, scale: float, topk: int, kpool: int,
+                          row0: int, row1: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Token positions attended by query rows [row0, row1) of bucketed prompts (token t at position t).
+
+    q [B, L, H, D] indexer queries, pk [B, L/kpool, D] pooled keys, w [B, L, H] head weights.
+    Requires row0 >= topk + kpool - 1, where every row has at least topk/kpool complete visible pools.
+    Returns idx [B, C, topk + kpool - 1] (topk pool tokens, then kpool-1 tail slots) and valid [B, C, same].
+    """
+    assert row0 >= topk + kpool - 1, (row0, topk, kpool)
+    b = q.shape[0]
+    p_all = pk.shape[1]
+    dev = q.device
+    qpos = torch.arange(row0, row1, device=dev)
+    s = index_scores(q[:, row0:row1], pk, w[:, row0:row1], scale)  # [B, C, P]
+    pool_end = torch.arange(p_all, device=dev) * kpool + (kpool - 1)
+    visible = pool_end.unsqueeze(0) <= qpos.unsqueeze(1)  # [C, P]
+    s = s.masked_fill(~visible.unsqueeze(0), torch.finfo(torch.float32).min)
+    sel = s.topk(topk // kpool, dim=-1).indices  # [B, C, topk/kpool], all visible for row0 >= topk + kpool - 1
+    tok = (sel.unsqueeze(-1) * kpool + torch.arange(kpool, device=dev)).flatten(-2)  # [B, C, topk]
+    tail_start = (qpos + 1) // kpool * kpool
+    tail = tail_start.unsqueeze(1) + torch.arange(kpool - 1, device=dev)  # [C, kpool-1]
+    tail_valid = tail <= qpos.unsqueeze(1)
+    tail = torch.where(tail_valid, tail, qpos.unsqueeze(1))
+    idx = torch.cat([tok, tail.unsqueeze(0).expand(b, -1, -1)], dim=-1)
+    valid = torch.cat([torch.ones_like(tok, dtype=torch.bool), tail_valid.unsqueeze(0).expand(b, -1, -1)], dim=-1)
+    return idx, valid
+
+
+def latent_gather_attention(q_lat: torch.Tensor, lat: torch.Tensor, idx: torch.Tensor, valid: torch.Tensor,
+                            scale: float) -> torch.Tensor:
+    """q_lat [B, C, H, R] (query already multiplied by W_UK^T), lat [B, L, R] prompt latents, idx/valid [B, C, K]
+    positions within each sequence -> latent-space attention output [B, C, H, R] (apply W_UV afterwards)."""
+    b, l, r = lat.shape
+    c, k = idx.shape[1], idx.shape[2]
+    offs = (torch.arange(b, device=idx.device) * l).view(b, 1, 1)
+    sel = lat.reshape(b * l, r).index_select(0, (idx + offs).reshape(-1)).view(b, c, k, r)
+    sc = torch.einsum("bchr,bckr->bchk", q_lat, sel).float() * scale
+    sc = sc.masked_fill(~valid.unsqueeze(2), float("-inf"))
+    a = torch.softmax(sc, dim=-1).to(lat.dtype)
+    return torch.einsum("bchk,bckr->bchr", a, sel)
+
+
+def decode_select_slots(q: torch.Tensor, w: torch.Tensor, kg_blocks: torch.Tensor, ape: torch.Tensor, scale: float,
+                        block_list: torch.Tensor, block_groups: torch.Tensor, block_kidx: torch.Tensor,
+                        block_usage: torch.Tensor, topk: int, kpool: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Physical KV slots attended by the current decode token of each (padded) sequence.
+
+    Same selection rule as decode_sparse_block_bias (HF-verified): top topk/kpool complete visible pools of the
+    sequence plus its incomplete tail pool. Inputs as there, plus block_list [N] (physical block id per entry).
+    Returns slots [Bp, topk + kpool - 1] and valid [Bp, same]; a row with nothing valid (pad sequence) gets slot 0
+    marked valid so its attention stays finite.
+    """
+    n, bs = kg_blocks.shape[:2]
+    bp = q.shape[0]
+    dev = q.device
+    pb = bs // kpool
+    is_real = block_groups >= 0
+    grp = block_groups.clamp(min=0).to(torch.long)
+    kidx = block_kidx.to(torch.long)
+    pk = pool_keys(kg_blocks, ape, kpool)  # [N, Pb, D]
+    s = index_scores(q[grp].unsqueeze(1), pk, w[grp].unsqueeze(1), scale).squeeze(1)  # [N, Pb]
+    last = kidx * bs + block_usage.to(torch.long) - 1
+    gidx = torch.where(is_real, grp, torch.full_like(grp, bp))
+    onehot = F.one_hot(gidx, num_classes=bp + 1).to(torch.long)  # [N, Bp+1]
+    seq_qpos = (onehot * last.unsqueeze(1)).amax(dim=0)[:bp]  # [Bp]
+    qpos = seq_qpos[grp]  # [N]
+    pool_end = kidx.unsqueeze(1) * bs + torch.arange(pb, device=dev) * kpool + (kpool - 1)
+    pvalid = (pool_end <= qpos.unsqueeze(1)) & is_real.unsqueeze(1)  # [N, Pb]
+    fmin = torch.finfo(torch.float32).min
+    s = s.masked_fill(~pvalid, fmin).reshape(-1)
+    pvalid = pvalid.reshape(-1)
+    own = grp.repeat_interleave(pb).unsqueeze(0) == torch.arange(bp, device=dev).unsqueeze(1)  # [Bp, N*Pb]
+    s_all = torch.where(own, s.unsqueeze(0), torch.full_like(s, fmin).unsqueeze(0))
+    v_all = own & pvalid.unsqueeze(0)
+    kk = min(topk // kpool, n * pb)
+    sel = s_all.topk(kk, dim=-1).indices  # [Bp, kk]
+    sel_valid = v_all.gather(1, sel)
+    blk = sel // pb
+    phys = block_list.to(torch.long)[blk]  # [Bp, kk]
+    pool_slots = ((phys * bs + (sel % pb) * kpool).unsqueeze(-1) + torch.arange(kpool, device=dev)).flatten(1)
+    pool_valid = sel_valid.unsqueeze(-1).expand(-1, -1, kpool).flatten(1)
+    # tail: tokens after the last complete pool, all inside the block holding the current token
+    in_last = (own.view(bp, n, pb)[:, :, 0] & is_real.unsqueeze(0) & (kidx.unsqueeze(0) * bs <= seq_qpos.unsqueeze(1)) &
+               (seq_qpos.unsqueeze(1) < kidx.unsqueeze(0) * bs + bs))  # [Bp, N]
+    has_last = in_last.any(dim=1)
+    i_last = in_last.to(torch.int32).argmax(dim=1).to(torch.long)
+    tail_start = (seq_qpos + 1) // kpool * kpool
+    tail_pos = tail_start.unsqueeze(1) + torch.arange(kpool - 1, device=dev)
+    tail_valid = (tail_pos <= seq_qpos.unsqueeze(1)) & has_last.unsqueeze(1)
+    tail_slots = (block_list.to(torch.long)[i_last] * bs).unsqueeze(1) + tail_pos - (kidx[i_last] * bs).unsqueeze(1)
+    slots = torch.cat([pool_slots, torch.where(tail_valid, tail_slots, torch.zeros_like(tail_slots))], dim=1)
+    valid = torch.cat([pool_valid, tail_valid], dim=1)
+    if slots.shape[1] < topk + kpool - 1:  # tiny block buckets: pad to the static width
+        pad = topk + kpool - 1 - slots.shape[1]
+        slots = F.pad(slots, (0, pad))
+        valid = F.pad(valid, (0, pad))
+    empty = ~valid.any(dim=1)
+    valid = torch.cat([valid[:, :1] | empty.unsqueeze(1), valid[:, 1:]], dim=1)
+    slots = torch.where(valid, slots, torch.zeros_like(slots))
+    return slots, valid
+
+
+def latent_decode_attention(q_lat: torch.Tensor, kv_rows: torch.Tensor, slots: torch.Tensor, valid: torch.Tensor,
+                            scale: float) -> torch.Tensor:
+    """q_lat [Bp, H, R], kv_rows [num_slots, R] latent cache, slots/valid [Bp, K] -> [Bp, H, R] latent output."""
+    bp, k = slots.shape
+    r = kv_rows.shape[-1]
+    sel = kv_rows.index_select(0, slots.reshape(-1)).view(bp, k, r)
+    sc = torch.einsum("bhr,bkr->bhk", q_lat, sel).float() * scale
+    sc = sc.masked_fill(~valid.unsqueeze(1), float("-inf"))
+    a = torch.softmax(sc, dim=-1).to(kv_rows.dtype)
+    return torch.einsum("bhk,bkr->bhr", a, sel)
+
 def dense_exact_len(topk: int, kpool: int) -> int:
     """Longest sequence for which the sparse selection covers every visible token."""
     return topk + kpool - 1
@@ -183,5 +304,6 @@ def dense_exact_len(topk: int, kpool: int) -> int:
 
 __all__ = [
