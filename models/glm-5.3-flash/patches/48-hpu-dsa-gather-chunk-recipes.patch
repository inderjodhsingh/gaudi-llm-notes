     def _dsa_sparse_prefill_rows(self, dense_out, q, latent_vec_k, attn_metadata, sparse):
         """Top-k KV gather for prefill rows whose visible prefix exceeds topk + kpool - 1 tokens.
 
         Rows [0, topk + kpool - 1) keep the dense kernel output unchanged (sparse selection covers their whole prefix,
-        and slicing the fused SDPA call is not bit-identical), later rows are recomputed from the 2051 selected
+        and slicing the fused SDPA call is not bit-identical); later rows are recomputed from the 2051 selected
         latents per query in MLA latent space; no L x L mask or bias is built.
+
+        Runs outside the regional decoder-layer graph (like the KDA chunked prefill): unrolled into one graph, the
+        per-chunk gathered latents (~1-2 GiB each) were all held by Synapse and warmup ran out of device memory.
+        Each chunk is its own static-shape compiled recipe, so its workspace is released before the next.
         """
