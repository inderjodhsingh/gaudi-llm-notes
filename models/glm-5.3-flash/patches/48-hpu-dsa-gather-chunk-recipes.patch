+def prefill_select_tokens(q: torch.Tensor, pk: torch.Tensor, w: torch.Tensor, scale: float, topk: int, kpool: int,
+                          row0: int, row1: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Token positions attended by query rows [row0, row1) of bucketed prompts (token t at position t).
+
+    q [B, L, H, D] indexer queries, pk [B, L/kpool, D] pooled keys, w [B, L, H] head weights.
+    Requires row0 >= topk + kpool - 1, where every row has at least topk/kpool complete visible pools.
+    Returns idx [B, C, topk + kpool - 1] (topk pool tokens, then kpool-1 tail slots) and valid [B, C, same].
+    """
+    assert row0 >= topk + kpool - 1, (row0, topk, kpool)
+    qpos = torch.arange(row0, row1, device=q.device)
+    return prefill_select_tokens_rows(q[:, row0:row1], pk, w[:, row0:row1], qpos, scale, topk, kpool)
+
+
 def latent_gather_attention(q_lat: torch.Tensor, lat: torch.Tensor, idx: torch.Tensor, valid: torch.Tensor,
                             scale: float) -> torch.Tensor:
     """q_lat [B, C, H, R] (query already multiplied by W_UK^T), lat [B, L, R] prompt latents, idx/valid [B, C, K]
@@ -297,6 +307,35 @@ def latent_decode_attention(q_lat: torch.Tensor, kv_rows: torch.Tensor, slots: t
     a = torch.softmax(sc, dim=-1).to(kv_rows.dtype)
     return torch.einsum("bhk,bkr->bhr", a, sel)
 
+
+def dsa_prefill_chunk(q_rows: torch.Tensor, qi_rows: torch.Tensor, wi_rows: torch.Tensor, qpos: torch.Tensor,
+                      pk: torch.Tensor, lat: torch.Tensor, w_uk_t: torch.Tensor, w_uv: torch.Tensor, attn_scale: float,
+                      idx_scale: float, topk: int, kpool: int) -> torch.Tensor:
+    """One block of sparse prefill rows: selection + latent gather attention + W_UV projection.
+
+    q_rows [B, C, H, Dqk] MLA queries, qi_rows [B, C, Hi, Di] / wi_rows [B, C, Hi] indexer queries and weights,
+    qpos [C] positions, pk [B, P, Di] pooled keys, lat [B, L, R] prompt latents, w_uk_t [H, Dqk, R], w_uv [H, R, V].
+    Returns [B, C, H * V].
+    """
+    b, c, h, _ = q_rows.shape
+    idx, valid = prefill_select_tokens_rows(qi_rows, pk, wi_rows, qpos, idx_scale, topk, kpool)
+    q_lat = torch.einsum("bchp,hpr->bchr", q_rows, w_uk_t)
+    o = latent_gather_attention(q_lat, lat, idx, valid, attn_scale)  # [B, C, H, R]
+    v = torch.einsum("bchr,hrv->bchv", o, w_uv)
+    return v.reshape(b, c, -1)
+
+
+_COMPILED_KERNELS: dict = {}
+
+
+def compiled_on(fn, device_type: str):
+    """Static-shape HPU compile of a kernel (one torch.compile object per function); eager elsewhere (CPU tests)."""
+    if device_type != "hpu":
+        return fn
+    if fn.__name__ not in _COMPILED_KERNELS:
+        _COMPILED_KERNELS[fn.__name__] = torch.compile(fn, backend="hpu_backend", dynamic=False)
+    return _COMPILED_KERNELS[fn.__name__]
+
 def dense_exact_len(topk: int, kpool: int) -> int:
     """Longest sequence for which the sparse selection covers every visible token."""
     return topk + kpool - 1
