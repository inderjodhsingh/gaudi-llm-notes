+        pieces = [dense_out.view(bsz, length, -1)[:, :exact]]
+        for n, r0 in enumerate(range(exact, length, self._DSA_PREFILL_CHUNK)):
             r1 = min(r0 + self._DSA_PREFILL_CHUNK, length)
-            idx, valid = prefill_select_tokens(qi4, pk, wi3, ind.softmax_scale, ind.topk_tokens, ind.kpool, r0, r1)
-            q_lat = torch.einsum("bchp,hpr->bchr", q4[:, r0:r1], self.W_UK_T)
-            o = latent_gather_attention(q_lat, lat, idx, valid, self.scale)
-            pieces.append(self._v_up_proj(o.reshape(-1, heads, self.kv_lora_rank)).view(bsz, r1 - r0, -1))
-        dense_rows = dense_out.view(bsz, length, -1)[:, :exact]
-        return torch.cat([dense_rows] + pieces, dim=1).reshape(bsz * length, -1)
+            pieces.append(
+                chunk_fn(q4[:, r0:r1], qi4[:, r0:r1], wi3[:, r0:r1], positions[r0:r1], pk, lat, self.W_UK_T, self.W_UV,
