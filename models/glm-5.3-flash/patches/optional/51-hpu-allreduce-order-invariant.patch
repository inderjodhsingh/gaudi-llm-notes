From e2ac446e195b1b61eb93a4180c4738423d65b6a7 Mon Sep 17 00:00:00 2001
From: Gaudi port <gaudi-port@users.noreply.github.com>
Date: Wed, 16 Sep 2026 18:33:23 +0000
Subject: [PATCH] patch 51: order-invariant TP/EP all-reduce
 (VLLM_HPU_ALLREDUCE_MODE), ported from abotsis pr/core

---
 .../device_communicators/hpu_communicator.py  | 71 ++++++++++++++++++-
 1 file changed, 70 insertions(+), 1 deletion(-)

diff --git a/vllm_gaudi/distributed/device_communicators/hpu_communicator.py b/vllm_gaudi/distributed/device_communicators/hpu_communicator.py
index 09b43cb..451a064 100644
--- a/vllm_gaudi/distributed/device_communicators/hpu_communicator.py
+++ b/vllm_gaudi/distributed/device_communicators/hpu_communicator.py
@@ -9,10 +9,57 @@ from vllm.distributed.device_communicators.base_device_communicator \
     import DeviceCommunicatorBase
 from vllm.distributed.parallel_state import GroupCoordinator, get_dp_group, get_tp_group, get_ep_group
 
+import os
+
 import habana_frameworks.torch as htorch  # noqa: F401
 
 from vllm_gaudi.v1.worker.hpu_dp_utils import get_hpu_dp_metadata
 
+# VLLM_HPU_ALLREDUCE_MODE selects how the TP/EP all-reduce sums partials. Ported from
+# abotsis/vllm-gaudi pr/core (commit 1587118). Default here is "hccl", i.e. unchanged
+# behaviour, so this patch is inert until the mode is set explicitly.
+#   hccl       dist.all_reduce in the tensor's dtype (previous and default behaviour).
+#   gather_sum all_gather the partials and sum them on every rank in rank order in fp32.
+#              The result does not depend on which rank owned which chunk. HCCL's
+#              reduce-scatter sums each chunk in a chunk-dependent rank order, and at
+#              [bs, hidden] a chunk is one decode row, so a row's residual after o_proj
+#              and the MoE down-proj depends on its position in the batch by about one
+#              bf16 ULP -- which on a model with recurrent state and near-tie MoE routing
+#              turns into different greedy tokens for co-batched requests.
+#   fp32       upcast, dist.all_reduce, downcast: fewer order-dependent roundings.
+#   transpose  all-reduce a hidden-major copy and transpose back, so an element's chunk
+#              depends on its hidden index rather than its row position.
+_ALLREDUCE_MODE = os.environ.get("VLLM_HPU_ALLREDUCE_MODE", "hccl").strip().lower()
+if _ALLREDUCE_MODE not in ("hccl", "fp32", "gather_sum", "transpose"):
+    raise ValueError(f"VLLM_HPU_ALLREDUCE_MODE must be hccl, fp32, gather_sum or transpose, got {_ALLREDUCE_MODE!r}")
+# Buffers whose gathered/upcast working set would exceed this fall back to
+# VLLM_HPU_ALLREDUCE_LARGE_MODE. Every all-reduce site inside a compiled region keeps its
+# working buffers, and a long prefill has many sites, so gather_sum at prefill width can
+# exhaust device memory. Decode buffers ([bs, hidden]) are far below the default.
+_ALLREDUCE_LARGE_MODE = os.environ.get("VLLM_HPU_ALLREDUCE_LARGE_MODE", "hccl").strip().lower()
+if _ALLREDUCE_LARGE_MODE not in ("hccl", "fp32", "transpose"):
+    raise ValueError(f"VLLM_HPU_ALLREDUCE_LARGE_MODE must be hccl, fp32 or transpose, got {_ALLREDUCE_LARGE_MODE!r}")
+_ALLREDUCE_ALT_MAX_BYTES = int(os.environ.get("VLLM_HPU_ALLREDUCE_ALT_MAX_BYTES", str(16 * 1024 * 1024)))
+# The mark_step below is a lazy-mode workaround for an older bridge bug. It is inert in
+# compile mode (PT_HPU_LAZY_MODE=0), which is what this port runs; kept behind a switch so
+# the behaviour is explicit rather than incidental.
+_ALLREDUCE_MARKSTEP = os.environ.get("VLLM_HPU_ALLREDUCE_MARKSTEP", "1") == "1"
+
+
+def sum_in_rank_order(gathered: torch.Tensor, world_size: int, dtype: torch.dtype) -> torch.Tensor:
+    """Sum a flat [world * n] gather in rank order with fp32 accumulation, then cast to [n].
+
+    A pure function of the gathered buffer: every rank computes the same bits, and a row's
+    result does not depend on its position in the buffer. Kept strictly 1-D and out-of-place
+    so dynamo can trace it in compile mode (the original in-place, N-D form tripped
+    fake-tensor shape inference on ``copy_``).
+    """
+    rows = gathered.view(world_size, -1)
+    acc = rows[0].float()
+    for rank in range(1, world_size):
+        acc = acc + rows[rank].float()
+    return acc.to(dtype)
+
 
 class HpuCommunicator(DeviceCommunicatorBase):
 
@@ -45,7 +92,29 @@ class HpuCommunicator(DeviceCommunicatorBase):
         # FIXME(kzawora): this is a workaround for a bug in Habana PT bridge
         # occurring when PT_HPU_ENABLE_LAZY_COLLECTIVES=true env var is used
         # (which is required for tensor parallel HPUGraph inference)
-        htorch.core.mark_step()
+        if _ALLREDUCE_MARKSTEP:
+            htorch.core.mark_step()
+        factor = self.world_size if _ALLREDUCE_MODE == "gather_sum" else 2
+        working_bytes = input_.numel() * input_.element_size() * factor
+        mode = _ALLREDUCE_MODE if working_bytes <= _ALLREDUCE_ALT_MAX_BYTES else _ALLREDUCE_LARGE_MODE
+        if mode == "gather_sum":
+            flat = input_.reshape(-1).contiguous()
+            gathered = torch.empty(self.world_size * flat.numel(), dtype=flat.dtype, device=flat.device)
+            dist.all_gather_into_tensor(gathered, flat, group=self.device_group)
+            summed = sum_in_rank_order(gathered, self.world_size, input_.dtype)
+            input_.copy_(summed.reshape(input_.shape))
+            return input_
+        if mode == "fp32":
+            upcast = input_.float()
+            dist.all_reduce(upcast, group=self.device_group)
+            input_.copy_(upcast.to(input_.dtype))
+            return input_
+        if mode == "transpose" and input_.dim() >= 2:
+            rows = input_.reshape(-1, input_.shape[-1])
+            hidden_major = rows.transpose(0, 1).contiguous()
+            dist.all_reduce(hidden_major, group=self.device_group)
+            input_.copy_(hidden_major.transpose(0, 1).reshape(input_.shape))
+            return input_
         dist.all_reduce(input_, group=self.device_group)
         return input_
 
-- 
