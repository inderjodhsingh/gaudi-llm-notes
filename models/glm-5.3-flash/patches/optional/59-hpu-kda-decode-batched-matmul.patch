From c89765a8caf8485cc1d4573b0dd86ece5defd8a8 Mon Sep 17 00:00:00 2001
From: Gaudi port <gaudi-port@users.noreply.github.com>
Date: Thu, 17 Sep 2026 15:45:44 +0000
Subject: [PATCH] patch 59: KDA decode as one batched matmul, folding the decay
 into both contractions

---
 vllm_gaudi/ops/hpu_kda_pytorch.py | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/vllm_gaudi/ops/hpu_kda_pytorch.py b/vllm_gaudi/ops/hpu_kda_pytorch.py
index d363ebb..e503fbc 100644
--- a/vllm_gaudi/ops/hpu_kda_pytorch.py
+++ b/vllm_gaudi/ops/hpu_kda_pytorch.py
@@ -85,11 +85,21 @@ def hpu_fused_recurrent_kda(
             qf = _l2norm_last_dim(qf)
             kf = _l2norm_last_dim(kf)
         qf = qf * scale
-        h = h * torch.exp(gf).to(h.dtype).unsqueeze(-2)
-        proj = torch.sum(h * kf.unsqueeze(-2), dim=-1)
+        # The decay factors out of BOTH contractions exactly. With e = exp(g) and h0 the pre-decay state:
+        #   proj = (h0 * e) @ k      = h0 @ (e * k)
+        #   out  = (h0 * e + v_new (x) k) @ q = h0 @ (e * q) + v_new * (k . q)
+        # so the two contractions hit the same pre-decay h0 and can be issued as ONE batched matmul against
+        # stack([e*k, e*q], -1). That replaces three full-size [N,H,D,D] elementwise products and three reductions
+        # with one gemv on the MME, and drops the state from ~16 passes to 3 (read for matmul, read + write for the
+        # update). Algebraically exact; scripts/test_kda_decode_equiv.py measures the residual at ~4e-7 relative,
+        # i.e. fp32 rounding. 34 of 45 layers take this path, so it is the dominant KDA decode cost.
+        e = torch.exp(gf).to(h.dtype)
+        p = torch.matmul(h, torch.stack((kf * e, qf * e), dim=-1))
+        proj = p[..., 0]
+        hq = p[..., 1]
         v_new = (vf - proj) * bf.unsqueeze(-1)
-        h = h + v_new.unsqueeze(-1) * kf.unsqueeze(-2)
-        out = torch.sum(h * qf.unsqueeze(-2), dim=-1)
+        out = hq + v_new * torch.sum(kf * qf, dim=-1).unsqueeze(-1)
+        h = h * e.unsqueeze(-2) + v_new.unsqueeze(-1) * kf.unsqueeze(-2)
         final_state.index_copy_(0, sidx, h.to(final_state.dtype))
         return out.unsqueeze(0).to(q.dtype) if B == 1 else out.view(B, T, H, D).to(q.dtype), final_state
 
