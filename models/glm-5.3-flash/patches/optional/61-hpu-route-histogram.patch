         topk_ids, emin, emax = _localize_routing_ids(topk_ids, self.experts_min, self.experts_max,
                                                           getattr(self, 'global_num_experts', None))
         tokens_num, _ = x.shape
@@ -1429,6 +1461,7 @@ class VllmMixtureOfExpertsOpFP8PerChannel(VllmMixtureOfExpertsOpBase):
         permuted_weights=True,
         activation="silu",
     ):
+        _route_hist_count(self, topk_ids)
         topk_ids, emin, emax = _localize_routing_ids(topk_ids, self.experts_min, self.experts_max,
                                                           getattr(self, 'global_num_experts', None))
         tokens_num, _ = x.shape
@@ -1650,6 +1683,7 @@ class VllmMixtureOfExpertsOpWNA16(torch.nn.Module):
         permuted_weights=True,
         activation="silu",
     ):
+        _route_hist_count(self, topk_ids)
