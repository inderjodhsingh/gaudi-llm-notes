 vllm_gaudi/extension/ops.py              | 34 +++++++++
 vllm_gaudi/v1/worker/hpu_model_runner.py | 96 ++++++++++++++++++++++++
 2 files changed, 130 insertions(+)

diff --git a/vllm_gaudi/extension/ops.py b/vllm_gaudi/extension/ops.py
index 705ba0a..4b179b7 100644
--- a/vllm_gaudi/extension/ops.py
+++ b/vllm_gaudi/extension/ops.py
@@ -661,6 +661,36 @@ class MoeMatmul(torch.nn.Module):
 
 
 
+# --- GLM-5.3 expert-usage histogram (patch 61; opt-in with GLM53_ROUTE_HIST_DIR) --------------------------------
+# Counts, per MoE op instance (= per decoder layer) and per phase (0 prompt, 1 decode), how many real token-slots
+# the router sent to each GLOBAL expert id. The runner sets ROUTE_HIST['phase'] and ROUTE_HIST['row_mask'] (a
+# [tokens] bool tensor marking unpadded rows, or None to count every row) before each model forward, keeps the
+# real-token counters in ROUTE_HIST['tokens'], and reads the per-op tensors on DUMP. Counting uses the global ids
+# before localisation, so every rank would see the same numbers. Static shapes only: index_add_ with a 0/1 weight,
+# no boolean indexing, no host sync; the MoE op runs eagerly (patch 37), so this adds ~2 small eager ops per layer.
+ROUTE_HIST = {"enabled": False, "phase": 0, "row_mask": None, "tokens": None}
+
+
+def _route_hist_count(op, topk_ids):
+    if not ROUTE_HIST["enabled"]:
+        return
+    hist = getattr(op, "_route_hist", None)
+    if hist is None:
+        n = int(getattr(op, "global_num_experts", 0) or 0)
+        if n <= 0:
+            return
+        hist = torch.zeros(2, n, dtype=torch.int64, device=topk_ids.device)
+        op._route_hist = hist
+    ids = topk_ids.reshape(-1).to(torch.int64)
+    rows, k = int(topk_ids.shape[0]), int(topk_ids.shape[-1])
+    mask = ROUTE_HIST["row_mask"]
+    if mask is None or int(mask.numel()) != rows:
+        w = torch.ones_like(ids)
+    else:
+        w = mask.to(torch.int64).unsqueeze(1).expand(rows, k).reshape(-1)
+    hist[ROUTE_HIST["phase"]].index_add_(0, ids, w)
+
+
 def _localize_routing_ids(routing_ids, experts_min, experts_max, global_num_experts=None):
     """Rebase global expert ids to this rank's local weight slots.
 
@@ -790,6 +820,7 @@ class VllmMixtureOfExpertsOp(VllmMixtureOfExpertsOpBase):
         return ret
 
     def forward(self, hidden_states, expert_routing_table, router_weights, permuted_weights=True, activation="silu"):
