+    # --- GLM-5.3 expert-usage histogram (patch 61, opt-in GLM53_ROUTE_HIST_DIR) ---------------------------------
+    # Per-layer, per-phase counts of which global expert each real token-slot was routed to, accumulated inside the
+    # MoE op (extension/ops.py _route_hist_count). The runner tells the op which rows of the padded batch are real
+    # and which phase is running, and answers two control files in the directory: RESET (zero everything) and DUMP
+    # (write hist_rank<r>_<n>.json). Rank 0 alone answers them: every rank routes identically after the all-reduce.
+    def _route_hist_init(self):
+        self._route_hist_dir = os.environ.get("GLM53_ROUTE_HIST_DIR")
+        self._route_hist_dump_n = 0
+        self._route_hist_rank = 0
+        if not self._route_hist_dir:
+            return
+        import sys
+        try:
+            self._route_hist_rank = get_tensor_model_parallel_rank()
+        except Exception:
+            self._route_hist_rank = int(os.environ.get("RANK", "0"))
+        os.makedirs(self._route_hist_dir, exist_ok=True)
+        _ext_ops.ROUTE_HIST["tokens"] = [torch.zeros((), dtype=torch.int64, device="hpu") for _ in range(2)]
+        _ext_ops.ROUTE_HIST["enabled"] = True
+        print(f"[ROUTE-HIST] rank {self._route_hist_rank}: enabled, dir {self._route_hist_dir}", file=sys.stderr, flush=True)
+
+    def _route_hist_set(self, phase, row_mask, warmup_mode):
+        if not getattr(self, "_route_hist_dir", None):
+            return
+        rh = _ext_ops.ROUTE_HIST
+        rh["enabled"] = not warmup_mode
+        rh["phase"] = phase
+        rh["row_mask"] = row_mask
+        if not warmup_mode and row_mask is not None and rh["tokens"] is not None:
+            rh["tokens"][phase] = rh["tokens"][phase] + row_mask.sum(dtype=torch.int64)
+
+    @staticmethod
+    def _route_hist_prefill_mask(token_ids, attn_metadata):
+        # [B, S] padded prompt batch: row b holds query_len[b] = seq_len - context_len real tokens first, then padding.
+        try:
+            sl = getattr(attn_metadata, "seq_lens_tensor", None)
+            cl = getattr(attn_metadata, "context_lens_tensor", None)
+            if sl is None:
+                return None
+            q = sl if cl is None else sl - cl
+            b, s = int(token_ids.shape[0]), int(token_ids.shape[-1])
+            q = q.to(device=token_ids.device)[:b]
+            return (torch.arange(s, device=token_ids.device).unsqueeze(0) < q.unsqueeze(1)).reshape(-1)
+        except Exception:
+            return None
+
+    @staticmethod
+    def _route_hist_decode_mask(token_ids, num_real):
+        # [padded_bs, 1] decode batch: the first num_real rows are live requests.
+        return torch.arange(int(token_ids.shape[0]), device=token_ids.device) < int(num_real)
+
+    def _route_hist_control(self):
+        d = getattr(self, "_route_hist_dir", None)
+        if not d or self._route_hist_rank != 0:
+            return
+        import json
+        import re
+        import sys
+        reset = os.path.join(d, "RESET")
+        if os.path.exists(reset):
+            for m in self.model.modules():
+                h = getattr(m, "_route_hist", None)
+                if h is not None:
+                    h.zero_()
+            _ext_ops.ROUTE_HIST["tokens"] = [torch.zeros((), dtype=torch.int64, device="hpu") for _ in range(2)]
+            os.replace(reset, reset + ".done")
+            print("[ROUTE-HIST] reset", file=sys.stderr, flush=True)
+        dump = os.path.join(d, "DUMP")
+        if os.path.exists(dump):
+            layers = {}
+            for name, m in self.model.named_modules():
+                h = getattr(m, "_route_hist", None)
+                if h is None:
+                    continue
+                mo = re.search(r"layers\.(\d+)\.", name)
+                hc = h.cpu().tolist()
+                layers[mo.group(1) if mo else name] = {"prefill": hc[0], "decode": hc[1]}
+            toks = [int(t.cpu()) for t in _ext_ops.ROUTE_HIST["tokens"]]
+            self._route_hist_dump_n += 1
+            out = {"schema": 1, "rank": self._route_hist_rank, "layers": layers,
+                   "tokens": {"prefill": toks[0], "decode": toks[1]},
+                   "note": "real (unpadded) token-slots per global expert id, per decoder layer, split by prompt "
+                           "forwards (prefill) and decode forwards; each real token contributes top-k slots"}
+            path = os.path.join(d, f"hist_rank{self._route_hist_rank}_{self._route_hist_dump_n}.json")
+            with open(path + ".tmp", "w") as f:
+                json.dump(out, f)
+            os.replace(path + ".tmp", path)
+            os.replace(dump, dump + ".done")
+            print(f"[ROUTE-HIST] dumped {path} ({len(layers)} layers, tokens {toks})", file=sys.stderr, flush=True)
+
     def _execute_model_generic(self,
                                token_ids,
                                position_ids,
@@ -4598,6 +4689,8 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
