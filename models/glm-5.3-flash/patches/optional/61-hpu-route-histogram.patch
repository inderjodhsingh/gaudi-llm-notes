         expert_routing_table, emin, emax = _localize_routing_ids(expert_routing_table, self.experts_min, self.experts_max,
                                                           getattr(self, 'global_num_experts', None))
         tokens_num, _ = hidden_states.shape
@@ -1331,6 +1362,7 @@ class VllmMixtureOfExpertsOpFP8(VllmMixtureOfExpertsOpBase):
         permuted_weights=True,
