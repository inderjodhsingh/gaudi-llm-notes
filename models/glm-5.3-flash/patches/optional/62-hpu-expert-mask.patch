@@ -0,0 +1,223 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU unit test for the GLM53_EXPERT_MASK runtime expert drop.
+
+Needs only torch + the Python stdlib + the two modules under test:
+  * vllm_gaudi/ops/hpu_expert_mask.py (loaded by file path, so importing the vllm_gaudi package
+    and its HPU platform plugin is not required);
+  * vllm.model_executor.layers.fused_moe.experts.cpu_moe.grouped_topk / select_experts, the routing
+    functions the HPU monolithic MoE path really calls (hpu_fused_moe.select_experts_from_routed).
+
+Run:  python3 tests/unit_tests/ops/test_expert_mask_cpu.py      (or via pytest)
+"""
+from __future__ import annotations
+
+import contextlib
+import importlib.util
+import io
+import json
+import os
+import pathlib
+import tempfile
+
+import torch
+
+_HERE = pathlib.Path(__file__).resolve()
+_MASK_MOD_PATH = _HERE.parents[3] / "vllm_gaudi" / "ops" / "hpu_expert_mask.py"
+
+
+def _load_mask_module():
+    if _MASK_MOD_PATH.exists():
+        spec = importlib.util.spec_from_file_location("hpu_expert_mask_under_test", _MASK_MOD_PATH)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        return mod
+    from vllm_gaudi.ops import hpu_expert_mask  # fallback: installed package
+    return hpu_expert_mask
+
+
+em = _load_mask_module()
+from vllm.model_executor.layers.fused_moe.experts.cpu_moe import grouped_topk, select_experts  # noqa: E402
+
+E, K, RSF = 288, 8, 2.5  # GLM-5.3-Flash: 288 routed experts, top-8, routed_scaling_factor 2.5
+
+
+def _inputs(seed=0, tokens=64, n_dropped=40, bias_boost=6.0):
+    g = torch.Generator().manual_seed(seed)
+    hidden = torch.randn(tokens, 16, generator=g)
+    logits = torch.randn(tokens, E, generator=g) * 2.0
+    bias = torch.randn(E, generator=g) * 0.1
+    dropped = torch.randperm(E, generator=g)[:n_dropped].sort().values
+    # Give the dropped experts a large POSITIVE correction bias: without the mask they must win the
+    # top-k, which proves the mask acts after the bias is added.
+    bias[dropped] += bias_boost
+    return hidden, logits, bias, dropped
+
+
+def _run(hidden, logits, bias, mask, renormalize=True, num_expert_group=1, topk_group=1):
+    return grouped_topk(hidden, logits, K, renormalize, num_expert_group=num_expert_group,
+                        topk_group=topk_group, scoring_func="sigmoid", routed_scaling_factor=RSF,
+                        e_score_correction_bias=bias, expert_mask=mask)
+
+
+def test_masked_experts_never_selected_and_weights_sum_to_scale():
+    hidden, logits, bias, dropped = _inputs()
+    mask = em.build_expert_mask(dropped.tolist(), E, K)
+    assert mask.shape == (E,) and mask.dtype == torch.float32
+    assert (mask[dropped] == torch.finfo(torch.float32).min).all() and (mask == 0).sum() == E - len(dropped)
+
+    # Sanity: the positive bias really does pull dropped experts into the unmasked top-k.
+    _, ids_unmasked = _run(hidden, logits, bias, None)
+    assert torch.isin(ids_unmasked, dropped).any(), "test setup: bias boost should select dropped experts"
+
+    w, ids = _run(hidden, logits, bias, mask)
+    assert ids.shape == (hidden.shape[0], K)
+    assert not torch.isin(ids, dropped).any(), "a masked expert was selected"
+    assert ids.unique(dim=-1).shape == ids.shape  # K distinct experts per token
+    assert torch.allclose(w.sum(-1), torch.full((hidden.shape[0], ), RSF)), "weights must sum to routed_scaling_factor"
+
+    # Exactness: masked routing == plain routing restricted to the kept experts (same scores, bias,
+    # renormalisation), with ids mapped back to global ids. Compare as sets per token (topk is unsorted).
+    kept = torch.tensor(sorted(set(range(E)) - set(dropped.tolist())))
+    w_ref, ids_ref = grouped_topk(hidden, logits[:, kept], K, True, num_expert_group=1, topk_group=1,
+                                  scoring_func="sigmoid", routed_scaling_factor=RSF,
+                                  e_score_correction_bias=bias[kept])
+    ids_ref = kept[ids_ref.long()]
+    order, order_ref = ids.argsort(-1), ids_ref.argsort(-1)
+    assert torch.equal(ids.gather(1, order), ids_ref.gather(1, order_ref))
+    assert torch.allclose(w.gather(1, order), w_ref.gather(1, order_ref), atol=1e-6)
+
+
+def test_no_renormalize_weights_are_unbiased_scores_times_scale():
+    hidden, logits, bias, dropped = _inputs(seed=1)
+    mask = em.build_expert_mask(dropped.tolist(), E, K)
+    w, ids = _run(hidden, logits, bias, mask, renormalize=False)
+    assert not torch.isin(ids, dropped).any()
+    expect = logits.sigmoid().gather(1, ids.long()) * RSF
+    assert torch.allclose(w, expect, atol=1e-6)
+
+
+def test_mask_none_and_all_zero_mask_change_nothing():
+    hidden, logits, bias, _ = _inputs(seed=2, n_dropped=0)
+    w0, i0 = _run(hidden, logits, bias, None)
+    w1, i1 = _run(hidden, logits, bias, torch.zeros(E))
+    assert torch.equal(i0, i1) and torch.equal(w0, w1)
+    # kwarg omitted entirely (what the plugin passes for an unmasked layer) == None
+    w2, i2 = grouped_topk(hidden, logits, K, True, num_expert_group=1, topk_group=1, scoring_func="sigmoid",
+                          routed_scaling_factor=RSF, e_score_correction_bias=bias)
+    assert torch.equal(i0, i2) and torch.equal(w0, w2)
+
+
+def test_select_experts_passthrough_and_guard():
+    hidden, logits, bias, dropped = _inputs(seed=3)
+    mask = em.build_expert_mask(dropped.tolist(), E, K)
+    w, ids = select_experts(hidden_states=hidden, router_logits=logits, top_k=K, use_grouped_topk=True,
+                            renormalize=True, topk_group=1, num_expert_group=1, custom_routing_function=None,
+                            scoring_func="sigmoid", routed_scaling_factor=RSF, e_score_correction_bias=bias,
+                            expert_mask=mask)
+    assert not torch.isin(ids, dropped).any()
+    assert torch.allclose(w.sum(-1), torch.full((hidden.shape[0], ), RSF))
+    try:
+        select_experts(hidden_states=hidden, router_logits=logits, top_k=K, use_grouped_topk=False,
+                       renormalize=True, expert_mask=mask)
+    except NotImplementedError:
+        pass
+    else:
+        raise AssertionError("expert_mask without grouped topk must be rejected")
+
+
+def test_grouped_variant_with_groups():
+    # Not GLM-5.3's config (n_group=1) but proves the mask composes with real group selection.
+    hidden, logits, bias, dropped = _inputs(seed=4, n_dropped=60)
+    mask = em.build_expert_mask(dropped.tolist(), E, K, num_expert_group=8, topk_group=4)
+    w, ids = _run(hidden, logits, bias, mask, num_expert_group=8, topk_group=4)
+    assert not torch.isin(ids, dropped).any()
+    assert torch.allclose(w.sum(-1), torch.full((hidden.shape[0], ), RSF))
+
+
+def test_build_expert_mask_validation():
+    for bad in ([E], [-1]):
+        try:
+            em.build_expert_mask(bad, E, K)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"out-of-range id {bad} accepted")
+    try:
+        em.build_expert_mask(list(range(E - K + 1)), E, K)  # only K-1 kept
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("mask leaving fewer than top_k experts accepted")
+    try:
+        em.build_expert_mask(list(range(36)), E, K, num_expert_group=8, topk_group=4)  # group 0 fully dropped
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("fully dropped group accepted")
+    assert em.layer_index_from_name("model.layers.17.mlp.experts") == 17
+    assert em.layer_index_from_name("model.layers.45.mlp.experts") == 45  # MTP block
+    assert em.layer_index_from_name("lm_head") is None
+
+
+class _FakeMoEConfig:
+    ep_rank = 3
+
+
+class _FakeRoutedExperts(torch.nn.Module):
+    """Mimics vllm RoutedExperts attributes read by install_expert_mask."""
+
+    def __init__(self, layer_name):
+        super().__init__()
+        self.layer_name = layer_name
+        self.global_num_experts = E
+        self.top_k = K
+        self.num_expert_group = 1
+        self.topk_group = 1
+        self.moe_config = _FakeMoEConfig()
+        self.e_score_correction_bias = torch.nn.Parameter(torch.zeros(E), requires_grad=False)
+
+
+def test_install_from_json_env_prints_once_and_unset_is_noop():
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, "mask.json")
+        with open(path, "w") as f:
+            json.dump({"17": [5, 200, 287, 5], "20": []}, f)
+        old = os.environ.get(em.EXPERT_MASK_ENV)
+        try:
+            os.environ[em.EXPERT_MASK_ENV] = path
+            err = io.StringIO()
+            l17, l20, l21 = (_FakeRoutedExperts(f"model.layers.{i}.mlp.experts") for i in (17, 20, 21))
+            with contextlib.redirect_stderr(err):
+                m17 = em.install_expert_mask(l17)
+                assert em.install_expert_mask(l20) is None
+                assert em.install_expert_mask(l21) is None
+            assert "[EXPERT-MASK] layer 17: dropped 3 experts" in err.getvalue()
+            assert err.getvalue().count("[EXPERT-MASK]") == 1  # only the non-empty layer prints
+            assert m17 is getattr(l17, em.EXPERT_MASK_ATTR)
+            assert em.EXPERT_MASK_ATTR in dict(l17.named_buffers()), "mask must be a registered buffer"
+            assert em.EXPERT_MASK_ATTR not in l17.state_dict(), "buffer must be non-persistent"
+            assert getattr(l20, em.EXPERT_MASK_ATTR) is None and getattr(l21, em.EXPERT_MASK_ATTR) is None
+            assert (m17[[5, 200, 287]] == torch.finfo(torch.float32).min).all() and (m17 == 0).sum() == E - 3
+            # re-install (weight reload) must not raise on the existing buffer
+            with contextlib.redirect_stderr(io.StringIO()):
+                em.install_expert_mask(l17)
+            # unset env: attribute None, nothing printed
+            del os.environ[em.EXPERT_MASK_ENV]
+            err = io.StringIO()
+            with contextlib.redirect_stderr(err):
+                assert em.install_expert_mask(l17) is None
+            assert getattr(l17, em.EXPERT_MASK_ATTR) is None and err.getvalue() == ""
+        finally:
+            if old is not None:
+                os.environ[em.EXPERT_MASK_ENV] = old
+            else:
+                os.environ.pop(em.EXPERT_MASK_ENV, None)
+
+
+if __name__ == "__main__":
+    tests = [(n, f) for n, f in sorted(globals().items()) if n.startswith("test_") and callable(f)]
+    for name, fn in tests:
+        fn()
+        print(f"PASS {name}")
+    print(f"{len(tests)} tests passed")
