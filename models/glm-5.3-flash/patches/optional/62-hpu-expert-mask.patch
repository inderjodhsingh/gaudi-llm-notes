diff --git a/vllm_gaudi/ops/hpu_expert_mask.py b/vllm_gaudi/ops/hpu_expert_mask.py
new file mode 100644
index 0000000..db15398
--- /dev/null
+++ b/vllm_gaudi/ops/hpu_expert_mask.py
@@ -0,0 +1,157 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in runtime expert mask for grouped-top-k MoE routing (GLM53_EXPERT_MASK).
+
+``GLM53_EXPERT_MASK=<path.json>`` points at ``{"<decoder layer idx>": [dropped GLOBAL expert ids], ...}``.
+For every MoE layer named in the file a non-persistent ``[num_experts]`` float32 buffer
+``layer.glm53_expert_mask`` is registered at load time (``install_expert_mask`` is called from the HPU MoE
+methods' ``process_weights_after_loading``): 0.0 for kept experts, ``finfo.min`` for dropped ones. The
+monolithic HPU routing path (``hpu_fused_moe.select_experts_from_routed`` -> vLLM
+``experts.cpu_moe.select_experts`` -> ``grouped_topk``) adds it to the selection scores AFTER the
+``e_score_correction_bias`` and BEFORE the top-k, so a dropped expert can never be selected, while the
+routing weights are still the unbiased sigmoid scores of the survivors, renormalised and scaled as before.
+
+Design constraints honoured here:
+* zero effect when the env var is unset: the attribute is ``None`` and no op is added to the graph;
+* static shapes: the mask is a fixed ``[num_experts]`` tensor built once on the layer's device, so the
+  compiled decoder-layer region gets one extra constant-shaped graph input and never recompiles on a
+  batch-shape change;
+* every rank builds the identical mask from the same file (routing is replicated across EP ranks), so the
+  expert outputs all-reduced over the EP group stay consistent.
+"""
+from __future__ import annotations
+
+import functools
+import json
+import math
+import os
+import re
+import sys
+
+import torch
+
+EXPERT_MASK_ENV = "GLM53_EXPERT_MASK"
+EXPERT_MASK_ATTR = "glm53_expert_mask"
+
+_LAYER_IDX_RE = re.compile(r"layers\.(\d+)\.")
+
+
+@functools.lru_cache(maxsize=8)
+def load_expert_mask_spec(path: str) -> dict[int, tuple[int, ...]]:
+    """Parse the mask file into ``{layer_idx: sorted unique dropped global ids}``.
+
+    Cached per path so the 40+ MoE layers of a model read the file once per process. Malformed input
+    raises ``ValueError`` at load time (fail loud, never silently route to a partially masked model).
+    """
+    with open(path) as f:
+        raw = json.load(f)
+    if not isinstance(raw, dict):
+        raise ValueError(f"{EXPERT_MASK_ENV}: {path} must hold a JSON object {{layer_idx: [expert ids]}}")
+    spec: dict[int, tuple[int, ...]] = {}
+    for key, ids in raw.items():
+        try:
+            layer_idx = int(key)
+        except (TypeError, ValueError) as e:
+            raise ValueError(f"{EXPERT_MASK_ENV}: layer key {key!r} is not an integer") from e
+        if not isinstance(ids, list) or not all(isinstance(i, int) and not isinstance(i, bool) for i in ids):
+            raise ValueError(f"{EXPERT_MASK_ENV}: layer {layer_idx}: expected a list of integer expert ids")
+        spec[layer_idx] = tuple(sorted(set(ids)))
+    return spec
+
+
+def layer_index_from_name(layer_name: str | None) -> int | None:
+    """``model.layers.17.mlp.experts`` -> 17 (same convention as the patch-61 routing histogram)."""
+    m = _LAYER_IDX_RE.search(layer_name or "")
+    return int(m.group(1)) if m else None
+
+
+def build_expert_mask(
+    dropped: tuple[int, ...] | list[int],
+    num_experts: int,
+    top_k: int,
+    num_expert_group: int = 1,
+    topk_group: int = 1,
+    dtype: torch.dtype = torch.float32,
+) -> torch.Tensor:
+    """Return the additive ``[num_experts]`` mask (0 kept / finfo.min dropped) after validating it.
+
+    Validation guarantees the top-k can always be filled from kept experts: at least ``top_k`` kept overall
+    and, when expert groups are used, at least ``ceil(top_k / topk_group)`` kept in every group (a
+    sufficient condition for any choice of ``topk_group`` groups). Group selection itself still runs on
+    the masked scores, so a fully dropped group can never be picked over a group with survivors.
+    """
+    dropped = tuple(sorted(set(int(i) for i in dropped)))
+    if any(i < 0 or i >= num_experts for i in dropped):
+        raise ValueError(f"expert mask: ids must lie in [0, {num_experts}), got {dropped}")
+    kept = num_experts - len(dropped)
+    if kept < top_k:
+        raise ValueError(f"expert mask: only {kept} of {num_experts} experts kept but top_k={top_k}")
+    num_expert_group = max(int(num_expert_group or 1), 1)
+    topk_group = max(int(topk_group or 1), 1)
+    if num_expert_group > 1:
+        if num_experts % num_expert_group:
+            raise ValueError(f"expert mask: {num_experts} experts not divisible by {num_expert_group} groups")
+        per_group = num_experts // num_expert_group
+        need = math.ceil(top_k / topk_group)
+        for g in range(num_expert_group):
+            lo, hi = g * per_group, (g + 1) * per_group
+            kept_g = per_group - sum(1 for i in dropped if lo <= i < hi)
+            if kept_g < need:
+                raise ValueError(f"expert mask: group {g} keeps {kept_g} experts, needs >= {need} "
+                                 f"(top_k={top_k}, topk_group={topk_group})")
+    mask = torch.zeros(num_experts, dtype=dtype)
+    if dropped:
+        mask[list(dropped)] = torch.finfo(dtype).min
+    return mask
+
+
+def _layer_device(layer: torch.nn.Module) -> torch.device:
+    for t in (getattr(layer, "e_score_correction_bias", None), getattr(layer, "w13_weight", None)):
+        if isinstance(t, torch.Tensor):
+            return t.device
+    try:
+        return next(layer.parameters()).device
+    except StopIteration:
+        return torch.device("cpu")
+
+
+def install_expert_mask(layer: torch.nn.Module) -> torch.Tensor | None:
+    """Attach ``layer.glm53_expert_mask`` (buffer, or ``None`` when unset/empty) and print one line.
+
+    Call once per MoE layer after its weights are loaded (before warmup/compile). Returns the mask.
+    """
+    # A previous install (weight reload) may have left a buffer or a plain attribute; clear both so
+    # register_buffer never hits "attribute already exists".
+    layer.__dict__.pop(EXPERT_MASK_ATTR, None)
+    layer._buffers.pop(EXPERT_MASK_ATTR, None)
+
+    path = os.environ.get(EXPERT_MASK_ENV)
+    if not path:
+        layer.register_buffer(EXPERT_MASK_ATTR, None, persistent=False)
+        return None
+
+    spec = load_expert_mask_spec(path)
+    layer_idx = layer_index_from_name(getattr(layer, "layer_name", None))
+    dropped = spec.get(layer_idx) if layer_idx is not None else None
+    if not dropped:
+        layer.register_buffer(EXPERT_MASK_ATTR, None, persistent=False)
+        return None
+
+    num_experts = int(layer.global_num_experts)
+    mask = build_expert_mask(
+        dropped,
+        num_experts,
+        int(layer.top_k),
+        int(getattr(layer, "num_expert_group", 1) or 1),
+        int(getattr(layer, "topk_group", 1) or 1),
+    )
+    mask = mask.to(_layer_device(layer))
+    layer.register_buffer(EXPERT_MASK_ATTR, mask, persistent=False)
+
+    moe_config = getattr(layer, "moe_config", None)
+    rank = getattr(moe_config, "ep_rank", 0) if moe_config is not None else 0
+    # print, not logger: logger.info from these modules does not reach the serve log.
+    print(f"[EXPERT-MASK] layer {layer_idx}: dropped {len(dropped)} experts "
+          f"(kept {num_experts - len(dropped)}/{num_experts}, rank {rank}, {path})",
+          file=sys.stderr, flush=True)
+    return mask
