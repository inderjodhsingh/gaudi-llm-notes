From 6fba3e9b07286e97e208f1c3527517b5da9dbac5 Mon Sep 17 00:00:00 2001
From: Gaudi port <gaudi-port@users.noreply.github.com>
Date: Fri, 18 Sep 2026 13:25:36 +0000
Subject: [PATCH] patch 63: expert_mask kwarg on cpu_moe grouped_topk /
 select_experts

Additive [E] mask applied to the selection scores after the correction bias and before the group/top-k selection;
routing weights unchanged for the survivors. Consumed by vllm-gaudi patch 62.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../layers/fused_moe/experts/cpu_moe.py             | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/vllm/model_executor/layers/fused_moe/experts/cpu_moe.py b/vllm/model_executor/layers/fused_moe/experts/cpu_moe.py
index 00c3dcc17..6663d6f59 100644
--- a/vllm/model_executor/layers/fused_moe/experts/cpu_moe.py
+++ b/vllm/model_executor/layers/fused_moe/experts/cpu_moe.py
@@ -63,6 +63,7 @@ def grouped_topk(
     scoring_func: str = "softmax",
     routed_scaling_factor: float = 1.0,
     e_score_correction_bias: torch.Tensor | None = None,
+    expert_mask: torch.Tensor | None = None,
 ) -> tuple[torch.Tensor, torch.Tensor]:
     assert hidden_states.shape[0] == gating_output.shape[0], "Number of tokens mismatch"
 
@@ -78,6 +79,14 @@ def grouped_topk(
     if e_score_correction_bias is not None:
         original_scores = scores
         scores = scores + e_score_correction_bias.unsqueeze(0)
+    if expert_mask is not None:
+        # Runtime expert drop (vllm-gaudi GLM53_EXPERT_MASK): additive [E] mask, 0 for kept
+        # experts and finfo.min for dropped ones, added AFTER the correction bias so a dropped
+        # expert can never win the top-k even with a positive bias. Group selection and the
+        # top-k below see the masked scores; the routing weights still come from the unbiased
+        # scores of the survivors and are renormalised as usual.
+        scores = scores + expert_mask.to(scores.dtype)
+    if e_score_correction_bias is not None:
         group_scores = (
             scores.view(num_token, num_expert_group, -1).topk(2, dim=-1)[0].sum(dim=-1)
         )
@@ -123,7 +132,10 @@ def select_experts(
     scoring_func: str = "softmax",
     routed_scaling_factor: float = 1.0,
     e_score_correction_bias: torch.Tensor | None = None,
+    expert_mask: torch.Tensor | None = None,
 ) -> tuple[torch.Tensor, torch.Tensor]:
+    if expert_mask is not None and not use_grouped_topk:
+        raise NotImplementedError("expert_mask is only supported with use_grouped_topk")
     if use_grouped_topk:
         assert topk_group is not None
         assert num_expert_group is not None
@@ -137,6 +149,7 @@ def select_experts(
             scoring_func=scoring_func,
             routed_scaling_factor=routed_scaling_factor,
             e_score_correction_bias=e_score_correction_bias,
+            expert_mask=expert_mask,
         )
     elif custom_routing_function is None:
         assert scoring_func == "softmax"
-- 
