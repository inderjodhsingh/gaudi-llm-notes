+# --- physical expert drop (GLM53_EXPERT_DROP) -------------------------------------------------------------------
+
+
+def reconcile_drop_env() -> str | None:
+    """Return the drop file path (or None) and force ``GLM53_EXPERT_MASK`` to the same file.
+
+    Dropping without the runtime mask must be impossible: the mask is what keeps a dropped expert out of the
+    top-k, so the drop env var installs the mask from its own file, and a mask env var naming a different file
+    is an error rather than a silent precedence rule.
+    """
+    drop = os.environ.get(EXPERT_DROP_ENV)
+    if not drop:
+        return None
+    mask = os.environ.get(EXPERT_MASK_ENV)
+    if mask and os.path.realpath(mask) != os.path.realpath(drop):
+        raise RuntimeError(f"{EXPERT_DROP_ENV}={drop} but {EXPERT_MASK_ENV}={mask}: the physical drop must use the "
+                           "mask from the same file (unset the mask var or point both at one file)")
+    if not mask:
+        os.environ[EXPERT_MASK_ENV] = drop
+    return drop
