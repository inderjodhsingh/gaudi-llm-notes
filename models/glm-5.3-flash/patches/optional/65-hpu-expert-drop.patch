+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU unit test for the GLM53_EXPERT_DROP physical expert drop (patches 64/65).
+
+Needs torch + the Python stdlib + the modules under test:
+  * vllm_gaudi/ops/hpu_expert_mask.py, loaded by file path (no HPU platform plugin needed);
+  * _localize_routing_ids / _route_hist_count from vllm_gaudi/extension/ops.py, extracted from the source with
+    ``ast`` and exec'd against plain torch (importing the module needs habana_frameworks);
+  * vLLM's ExpertMapManager (patch 64 hook) and cpu_moe.grouped_topk (the routing the HPU monolithic path runs).
+
+Run:  python3 tests/unit_tests/ops/test_expert_drop_cpu.py      (or via pytest)
+"""
+from __future__ import annotations
+
+import ast
+import contextlib
+import importlib.util
+import io
+import json
+import os
+import pathlib
+import tempfile
+
+import torch
+
+_HERE = pathlib.Path(__file__).resolve()
+_ROOT = _HERE.parents[3]
+_MASK_MOD_PATH = _ROOT / "vllm_gaudi" / "ops" / "hpu_expert_mask.py"
+_OPS_PATH = _ROOT / "vllm_gaudi" / "extension" / "ops.py"
+
+E, K, RSF, EP = 288, 8, 2.5, 8  # GLM-5.3-Flash: 288 routed experts, top-8, scale 2.5, EP=8 (36 per rank)
+
+
+def _load_mask_module():
+    spec = importlib.util.spec_from_file_location("hpu_expert_mask_under_test", _MASK_MOD_PATH)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _load_ops_functions():
+    """Exec only ROUTE_HIST / _route_hist_count / _localize_routing_ids from extension/ops.py (real source)."""
+    tree = ast.parse(_OPS_PATH.read_text())
+    wanted = {"_route_hist_count", "_localize_routing_ids"}
+    nodes = []
+    for node in tree.body:
+        if isinstance(node, ast.FunctionDef) and node.name in wanted:
+            nodes.append(node)
+        elif isinstance(node, ast.Assign) and any(
+                isinstance(t, ast.Name) and t.id == "ROUTE_HIST" for t in node.targets):
+            nodes.append(node)
+    assert len(nodes) == 3, [getattr(n, "name", "ROUTE_HIST") for n in nodes]
+    ns = {"torch": torch}
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), str(_OPS_PATH), "exec"), ns)
+    return ns
+
+
+em = _load_mask_module()
+ops = _load_ops_functions()
+from vllm.model_executor.layers.fused_moe.experts.cpu_moe import grouped_topk  # noqa: E402
+
+
+@contextlib.contextmanager
+def _env(**kv):
+    old = {k: os.environ.get(k) for k in kv}
+    try:
+        for k, v in kv.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+        em._cached_plan.cache_clear()
+        em.load_expert_mask_spec.cache_clear()
+        yield
+    finally:
+        for k, v in old.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+        em._cached_plan.cache_clear()
+        em.load_expert_mask_spec.cache_clear()
+
+
+# Layer 17: strongly non-uniform. rank 0 keeps 36, rank 1 keeps 1 (drops 35), rank 2 keeps 14, rank 5 keeps 5,
+# others keep 36; 88 dropped, 200 kept. Layer 20: rank 2 fully dropped -> ValueError. Layer 30: empty list.
+_L17_DROPPED = sorted(set(range(37, 72)) | set(range(72, 88)) | set(range(180, 211)) | {100, 101, 102, 103, 104, 105})
+_L20_DROPPED = list(range(72, 108))
+SPEC = {"17": _L17_DROPPED, "30": [], "44": [0, 287]}
+
+
+def _write_spec(d, spec=SPEC, name="drop.json"):
+    path = os.path.join(d, name)
+    with open(path, "w") as f:
+        json.dump(spec, f)
+    return path
+
+
+def test_plan_kept_dense_ids_and_per_rank_ranges():
+    plan = em.expert_plan(17, EP, E, _L17_DROPPED)
+    kept = [g for g in range(E) if g not in set(_L17_DROPPED)]
+    assert list(plan.kept) == kept and plan.num_kept == 200 and plan.dropped == tuple(_L17_DROPPED)
+    assert plan.rank_slice == tuple((36 * r, 36 * r + 36) for r in range(EP))
+    assert plan.rank_count == (36, 1, 14, 36, 36, 5, 36, 36)  # non-uniform per rank
+    assert sum(plan.rank_count) == plan.num_kept
+    starts = [0]
+    for n in plan.rank_count[:-1]:
+        starts.append(starts[-1] + n)
+    assert plan.rank_start == tuple(starts)
+    g2d = plan.global_to_dense()
+    assert len(g2d) == E and plan.sentinel == 200
+    assert all(g2d[g] == 200 for g in _L17_DROPPED)
+    assert [g2d[g] for g in kept] == list(range(200))  # dense id = rank among kept, ascending
+    for r in range(EP):
+        lo, hi = plan.rank_slice[r]
+        start, n = plan.local_range(r)
+        assert plan.experts_range(r) == (start, start + n - 1)
+        loc = plan.local_to_global(r)
+        assert len(loc) == n and all(lo <= g < hi for g in loc)  # keeps exactly its original slice's kept ids
+        assert [g2d[g] for g in loc] == list(range(start, start + n))  # contiguous dense range
+        m = plan.expert_map(r)
+        assert m.device.type == "cpu" and m.dtype == torch.int32
+        assert m.dtype == torch.int32 and m.shape == (E, )
+        assert (m != -1).sum() == n and m[list(loc)].tolist() == list(range(n))
+        assert all(m[g] == -1 for g in _L17_DROPPED)
+    inv = plan.dense_to_global()
+    assert len(inv) == 201 and inv[:200] == kept and inv[200] == E  # sentinel -> overflow bin
+    # uniform ranks stay at ep_rank*36 -> start only shifts by the earlier drops
+    assert plan.rank_start[0] == 0 and plan.rank_start[3] == 36 + 1 + 14
+
+
+def test_plan_rank_keeping_zero_raises_and_validation():
+    try:
+        em.expert_plan(20, EP, E, _L20_DROPPED)
+    except ValueError as e:
+        assert "rank 2" in str(e) and "keep 0" in str(e)
+    else:
+        raise AssertionError("a rank keeping 0 experts must be rejected")
+    for bad in ([E], [-1]):
+        try:
+            em.expert_plan(3, EP, E, bad)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError(f"out-of-range id {bad} accepted")
+    # remainder placement matches vLLM's linear rule (10 experts on 4 ranks -> 3,3,2,2)
+    assert em._linear_slices(10, 4) == [(0, 3), (3, 6), (6, 8), (8, 10)]
+    p = em.expert_plan(0, 4, 10, [0, 9])
+    assert p.rank_count == (2, 3, 2, 1) and p.rank_start == (0, 2, 5, 7)
+    # no drop at all is a valid identity plan
+    p = em.expert_plan(3, EP, E, [])
+    assert p.rank_count == (36, ) * EP and p.global_to_dense() == list(range(E))
+
+
+def test_drop_env_reconciles_mask_env():
+    with tempfile.TemporaryDirectory() as d:
+        path = _write_spec(d)
+        other = _write_spec(d, {"17": [1]}, "other.json")
+        with _env(GLM53_EXPERT_DROP=None, GLM53_EXPERT_MASK=None):
+            assert em.reconcile_drop_env() is None and em.EXPERT_MASK_ENV not in os.environ
+            assert em.expert_drop_plan_for("model.layers.17.mlp.experts", EP, E) is None
+        with _env(GLM53_EXPERT_DROP=path, GLM53_EXPERT_MASK=None):
+            assert em.reconcile_drop_env() == path
+            assert os.environ[em.EXPERT_MASK_ENV] == path  # drop installs the mask from its own file
+            plan = em.expert_drop_plan_for("model.layers.17.mlp.experts", EP, E)
+            assert plan is not None and plan.layer_idx == 17
+            assert em.expert_drop_plan_for("model.layers.30.mlp.experts", EP, E) is None  # empty list
+            assert em.expert_drop_plan_for("model.layers.45.mlp.experts", EP, E) is None  # MTP unlisted -> dense
+            assert em.expert_drop_plan_for("lm_head", EP, E) is None
+            assert em.expert_drop_plan_for("model.layers.17.mlp.experts", EP, E) is plan  # cached
+        with _env(GLM53_EXPERT_DROP=path, GLM53_EXPERT_MASK=other):
+            try:
+                em.reconcile_drop_env()
+            except RuntimeError:
+                pass
+            else:
+                raise AssertionError("mask file != drop file must fail loud")
+        with _env(GLM53_EXPERT_DROP=path, GLM53_EXPERT_MASK=os.path.join(d, ".", "drop.json")):
+            assert em.reconcile_drop_env() == path  # same file spelled differently is fine
+        with _env(GLM53_EXPERT_DROP=path, GLM53_EXPERT_MASK=None):
+            try:
+                em.expert_drop_plan_for("model.layers.20.mlp.experts", EP, E)  # not in SPEC -> None
+                em._cached_plan.cache_clear()
+                em.load_expert_mask_spec.cache_clear()
+                with open(path, "w") as f:
+                    json.dump({"20": _L20_DROPPED}, f)
+                em.expert_drop_plan_for("model.layers.20.mlp.experts", EP, E)
+            except ValueError:
+                pass
+            else:
+                raise AssertionError("empty rank in the file must fail at plan time")
+
+
+def test_expert_map_override_and_log_line():
+    with tempfile.TemporaryDirectory() as d:
+        path = _write_spec(d)
+        with _env(GLM53_EXPERT_DROP=path, GLM53_EXPERT_MASK=None):
+            plan = em.expert_plan(17, EP, E, _L17_DROPPED)
+            for r in range(EP):
+                err = io.StringIO()
+                with contextlib.redirect_stderr(err):
+                    n_r, m = em.expert_map_override("model.layers.17.mlp.experts", EP, r, E)
+                start, n = plan.local_range(r)
+                assert n_r == n and torch.equal(m, plan.expert_map(r))
+                assert err.getvalue() == (f"[EXPERT-DROP] layer 17 rank {r}: keeps {n} of 36 local "
+                                          f"(dense [{start}, {start + n})), global kept 200 of 288\n")
+            err = io.StringIO()
+            with contextlib.redirect_stderr(err):
+                assert em.expert_map_override("model.layers.18.mlp.experts", EP, 0, E) is None
+                assert em.expert_map_override("model.layers.45.mlp.experts", EP, 0, E) is None
+            assert err.getvalue() == ""
+        with _env(GLM53_EXPERT_DROP=None, GLM53_EXPERT_MASK=None):
+            assert em.expert_map_override("model.layers.17.mlp.experts", EP, 0, E) is None
+
+
+def _vllm_manager(rank, layer_name, enable_eplb=False, use_ep=True):
+    from vllm.model_executor.layers.fused_moe.config import FusedMoEParallelConfig
+    from vllm.model_executor.layers.fused_moe.expert_map_manager import ExpertMapManager
+    ep = EP if use_ep else 1
+    cfg = FusedMoEParallelConfig(tp_size=EP, pcp_size=1, dp_size=1, ep_size=ep, tp_rank=rank, pcp_rank=0,
+                                 dp_rank=0, ep_rank=rank if use_ep else 0, sp_size=1, use_ep=use_ep,
+                                 all2all_backend="naive", enable_eplb=enable_eplb)
+    return ExpertMapManager(max_num_batched_tokens=64, top_k=K, global_num_experts=E, num_redundant_experts=0,
+                            num_expert_group=1, moe_parallel_config=cfg, placement_strategy="linear",
+                            enable_eplb=enable_eplb, layer_name=layer_name)
+
+
+def test_vllm_expert_map_manager_override_and_env_unset_noop():
+    """Patch 64: the real ExpertMapManager takes the plugin's override; unset env is byte-identical."""
+    from vllm.model_executor.layers.fused_moe import expert_map_manager as emm
+    assert emm.get_expert_map_override() is em.expert_map_override  # registered at module import
+    ref = {r: _vllm_manager(r, "model.layers.17.mlp.experts") for r in range(EP)}  # env unset
+    with tempfile.TemporaryDirectory() as d:
+        path = _write_spec(d)
+        with _env(GLM53_EXPERT_DROP=path, GLM53_EXPERT_MASK=None):
+            plan = em.expert_plan(17, EP, E, _L17_DROPPED)
+            with contextlib.redirect_stderr(io.StringIO()):
+                for r in range(EP):
+                    mgr = _vllm_manager(r, "model.layers.17.mlp.experts")
+                    assert mgr.override_active and mgr.local_num_experts == plan.rank_count[r]
+                    assert torch.equal(mgr.expert_map, plan.expert_map(r)) and mgr.expert_mask is None
+                    assert mgr.get_local_expert_ids() == list(plan.local_to_global(r))
+                    for g in plan.local_to_global(r):
+                        assert mgr.is_local_expert(g)
+                    for g in _L17_DROPPED:
+                        assert not mgr.is_local_expert(g)
+                    try:
+                        mgr.update(mgr.moe_parallel_config, E)
+                    except RuntimeError:
+                        pass
+                    else:
+                        raise AssertionError("elastic EP update must be refused under an override")
+                    # unlisted layer on the same rank: stock placement
+                    plain = _vllm_manager(r, "model.layers.18.mlp.experts")
+                    assert not plain.override_active and plain.local_num_experts == 36
+                    assert torch.equal(plain.expert_map, ref[r].expert_map)
+                try:
+                    _vllm_manager(0, "model.layers.17.mlp.experts", enable_eplb=True)
+                except ValueError:
+                    pass
+                else:
+                    raise AssertionError("EPLB + override must be refused")
+                # TP without EP: the drop cannot take effect (no expert_map is consulted) -> clear ValueError
+                try:
+                    _vllm_manager(0, "model.layers.17.mlp.experts", use_ep=False)
+                except ValueError as e:
+                    assert "requires expert parallelism" in str(e), str(e)
+                else:
+                    raise AssertionError("override without EP must be refused")
+                # an unlisted layer without EP is untouched (hook returns None)
+                mgr = _vllm_manager(0, "model.layers.18.mlp.experts", use_ep=False)
+                assert not mgr.override_active and mgr.local_num_experts == E and mgr.expert_map is None
+    # env unset again: the hook returns None and everything is the standard placement
+    for r in range(EP):
+        mgr = _vllm_manager(r, "model.layers.17.mlp.experts")
+        assert not mgr.override_active and mgr.local_num_experts == 36
+        assert torch.equal(mgr.expert_map, ref[r].expert_map)
+        assert mgr.expert_map[36 * r:36 * r + 36].tolist() == list(range(36))
+
+
+class _FakeMoEConfig:
+
+    def __init__(self, rank):
+        self.ep_rank = rank
+        self.ep_size = EP
+        self.dp_size = 1
+
+
+class _FakeOp(torch.nn.Module):
+
+    def __init__(self, global_num_experts, num_experts, experts_min, experts_max):
+        super().__init__()
+        self.global_num_experts = global_num_experts
+        self.num_experts = num_experts
+        self.experts_min = experts_min
+        self.experts_max = experts_max
+
+
+class _FakeRoutedExperts(torch.nn.Module):
+    """Mimics vllm RoutedExperts after patch 64 sized the layer to n_r (or to 36 when uncut)."""
+
+    def __init__(self, layer_name, rank, local, expert_map=None, grouped=True):
+        super().__init__()
+        self.layer_name = layer_name
+        self.global_num_experts = E
+        self.local_num_experts = local
+        self.top_k = K
+        self.use_grouped_topk = grouped
+        self.num_expert_group = 1
+        self.topk_group = 1
+        self.moe_config = _FakeMoEConfig(rank)
+        self.e_score_correction_bias = torch.nn.Parameter(torch.zeros(E), requires_grad=False)
+        self.w13_weight = torch.nn.Parameter(torch.zeros(local, 4, 2, dtype=torch.float8_e4m3fn), requires_grad=False)
+        self.w2_weight = torch.nn.Parameter(torch.zeros(local, 2, 2, dtype=torch.float8_e4m3fn), requires_grad=False)
+        self.register_buffer("expert_map", expert_map, persistent=False)
+
+
+def test_install_expert_drop_on_fake_layer_and_moe_op_args():
+    with tempfile.TemporaryDirectory() as d:
+        path = _write_spec(d)
+        with _env(GLM53_EXPERT_DROP=path, GLM53_EXPERT_MASK=None):
+            plan = em.expert_drop_plan_for("model.layers.17.mlp.experts", EP, E)  # the cached plan install uses
+            assert plan.rank_count == em.expert_plan(17, EP, E, _L17_DROPPED).rank_count
+            for r in (0, 1, 2, 5, 7):
+                start, n = plan.local_range(r)
+                layer = _FakeRoutedExperts("model.layers.17.mlp.experts", r, n, plan.expert_map(r))
+                args = em.moe_op_expert_args(layer)
+                assert args == (200, n, start, start + n - 1)
+                layer.moe_op = _FakeOp(*args)
+                with contextlib.redirect_stderr(io.StringIO()):
+                    em.install_expert_mask(layer)
+                dense = em.install_expert_drop(layer)
+                assert dense.dtype == torch.int64 and dense.tolist() == plan.global_to_dense()
+                assert em.EXPERT_DENSE_ATTR in dict(layer.named_buffers())
+                assert em.EXPERT_DENSE_ATTR not in layer.state_dict()  # non-persistent
+                assert getattr(layer, em.EXPERT_DROP_PLAN_ATTR) is plan
+                assert em.local_expert_offset(layer) == start
+                inv = getattr(layer.moe_op, em.EXPERT_DROP_INVERSE_ATTR)
+                assert inv.tolist() == plan.dense_to_global() and em.EXPERT_DROP_INVERSE_ATTR in dict(
+                    layer.moe_op.named_buffers())
+                assert getattr(layer.moe_op, em.EXPERT_DROP_HIST_WIDTH_ATTR) == E
+                # re-install (weight reload) is idempotent
+                with contextlib.redirect_stderr(io.StringIO()):
+                    em.install_expert_mask(layer)
+                em.install_expert_drop(layer)
+
+            # fail-loud cases (rank 2 keeps 14)
+            start, n = plan.local_range(2)
+
+            def expect_runtime_error(build, what):
+                layer = build()
+                with contextlib.redirect_stderr(io.StringIO()):
+                    em.install_expert_mask(layer)
+                try:
+                    em.install_expert_drop(layer)
+                except RuntimeError:
+                    pass
+                else:
+                    raise AssertionError(f"{what} must fail loud")
+
+            # vLLM did not shrink the layer (patch 64 missing): 36 local instead of 20
+            expect_runtime_error(lambda: _FakeRoutedExperts("model.layers.17.mlp.experts", 2, 36), "uncut layer")
+            try:
+                em.moe_op_expert_args(_FakeRoutedExperts("model.layers.17.mlp.experts", 2, 36))
+            except RuntimeError:
+                pass
+            else:
+                raise AssertionError("moe_op_expert_args on an uncut layer must fail loud")
+            # MAX_EXPERTS_PER_SLICE slicing that would truncate the kept experts (14 = 3 x 4 + 2) must be refused;
+            # a slicing that covers every expert (14 = 2 x 7) is accepted.
+            def sliced_op(n_slice, per_group):
+                layer = _FakeRoutedExperts("model.layers.17.mlp.experts", 2, n, plan.expert_map(2))
+                layer.moe_op = _FakeOp(*em.moe_op_expert_args(layer))
+                layer.moe_op.moe_n_slice = n_slice
+                layer.moe_op.num_expert_per_group = per_group
+                return layer
+            expect_runtime_error(lambda: sliced_op(3, n // 3), "truncating expert slicing")
+            layer = sliced_op(2, n // 2)
+            with contextlib.redirect_stderr(io.StringIO()):
+                em.install_expert_mask(layer)
+            assert em.install_expert_drop(layer) is not None
+            # op built with the stock range
+            def bad_op():
+                layer = _FakeRoutedExperts("model.layers.17.mlp.experts", 2, n, plan.expert_map(2))
+                layer.moe_op = _FakeOp(E, n, 2 * n, 3 * n - 1)
+                return layer
+            expect_runtime_error(bad_op, "op with ep_rank*n range")
+            # wrong expert_map
+            expect_runtime_error(lambda: _FakeRoutedExperts("model.layers.17.mlp.experts", 2, n, plan.expert_map(3)),
+                                 "expert_map of another rank")
+            # non-grouped routing (mask/remap never applied)
+            expect_runtime_error(lambda: _FakeRoutedExperts("model.layers.17.mlp.experts", 2, n, plan.expert_map(2),
+                                                            grouped=False), "non-grouped routing")
+            # mask missing entirely
+            layer = _FakeRoutedExperts("model.layers.17.mlp.experts", 2, n, plan.expert_map(2))
+            try:
+                em.install_expert_drop(layer)
+            except RuntimeError:
+                pass
+            else:
+                raise AssertionError("drop without the mask must fail loud")
+            # mask installed but from a different spec (dropped set mismatch)
+            layer = _FakeRoutedExperts("model.layers.17.mlp.experts", 2, n, plan.expert_map(2))
+            layer.register_buffer(em.EXPERT_MASK_ATTR, em.build_expert_mask([1, 2], E, K), persistent=False)
+            try:
+                em.install_expert_drop(layer)
+            except RuntimeError:
+                pass
+            else:
+                raise AssertionError("mask/plan mismatch must fail loud")
+            # unlisted layer: no plan, buffer None, stock op args, offset ep_rank * local
+            layer = _FakeRoutedExperts("model.layers.18.mlp.experts", 3, 36)
+            with contextlib.redirect_stderr(io.StringIO()):
+                em.install_expert_mask(layer)
+            assert em.install_expert_drop(layer) is None
+            assert getattr(layer, em.EXPERT_DENSE_ATTR) is None and getattr(layer, em.EXPERT_DROP_PLAN_ATTR) is None
+            assert em.moe_op_expert_args(layer) == (E, 36, 108, 143) and em.local_expert_offset(layer) == 108
+            # methods without mask/remap refuse the drop only for dropped layers
+            em.assert_no_expert_drop(layer, "x")
+            try:
+                em.assert_no_expert_drop(_FakeRoutedExperts("model.layers.17.mlp.experts", 0, 36), "x")
+            except RuntimeError:
+                pass
+            else:
+                raise AssertionError("assert_no_expert_drop must raise for a dropped layer")
+
+
+def test_env_unset_is_a_noop():
+    with _env(GLM53_EXPERT_DROP=None, GLM53_EXPERT_MASK=None):
+        for r in range(EP):
+            layer = _FakeRoutedExperts("model.layers.17.mlp.experts", r, 36)
+            err = io.StringIO()
+            with contextlib.redirect_stderr(err):
+                assert em.install_expert_mask(layer) is None
+                assert em.install_expert_drop(layer) is None
+            assert err.getvalue() == ""
+            assert getattr(layer, em.EXPERT_DENSE_ATTR) is None
+            assert getattr(layer, em.EXPERT_DROP_PLAN_ATTR) is None
+            assert em.moe_op_expert_args(layer) == (E, 36, 36 * r, 36 * r + 35)  # stock ep_rank * local range
+            assert em.local_expert_offset(layer) == 36 * r
