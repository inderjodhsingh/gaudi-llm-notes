+
+def _linear_slices(num_experts: int, ep_size: int) -> list[tuple[int, int]]:
+    """Global id slice [lo, hi) per EP rank, vLLM's linear placement (expert_map_manager.determine_expert_map)."""
+    base, rem = divmod(num_experts, ep_size)
+    out = []
+    for r in range(ep_size):
+        lo = r * base + min(r, rem)
+        out.append((lo, lo + base + (1 if r < rem else 0)))
+    return out
+
+
+class ExpertDropPlan:
+    """Per-layer physical drop plan shared by all EP ranks (every rank computes the identical plan).
+
+    A plain class (not a dataclass): the unit tests load this module by file path, where dataclass annotation
+    resolution needs the module in ``sys.modules``.
+    """
+    __slots__ = ("layer_idx", "num_experts", "ep_size", "dropped", "kept", "rank_slice", "rank_start", "rank_count")
+
+    def __init__(self, layer_idx: int, num_experts: int, ep_size: int, dropped: tuple[int, ...],
+                 kept: tuple[int, ...], rank_slice: tuple[tuple[int, int], ...], rank_start: tuple[int, ...],
+                 rank_count: tuple[int, ...]):
+        self.layer_idx = layer_idx
+        self.num_experts = num_experts  # true global count (gate width), 288
+        self.ep_size = ep_size
+        self.dropped = dropped  # sorted global ids
+        self.kept = kept  # sorted global ids; dense id of kept[i] is i
+        self.rank_slice = rank_slice  # original global slice [lo, hi) per rank
+        self.rank_start = rank_start  # first dense id per rank
+        self.rank_count = rank_count  # n_r: kept experts per rank
+
+    def __repr__(self) -> str:
+        return (f"ExpertDropPlan(layer={self.layer_idx}, kept={self.num_kept}/{self.num_experts}, "
+                f"rank_start={self.rank_start}, rank_count={self.rank_count})")
+
+    @property
+    def num_kept(self) -> int:
+        return len(self.kept)
+
+    @property
+    def sentinel(self) -> int:
+        """Dense id given to a dropped expert: above every rank's range, so the kernel drops it."""
+        return self.num_kept
+
+    def global_to_dense(self) -> list[int]:
+        table = [self.sentinel] * self.num_experts
+        for d, g in enumerate(self.kept):
+            table[g] = d
+        return table
+
+    def dense_to_global(self) -> list[int]:
+        """Inverse table for the routing histogram; the sentinel maps to an overflow bin ``num_experts``."""
+        return list(self.kept) + [self.num_experts]
+
+    def local_range(self, rank: int) -> tuple[int, int]:
+        """(start_r, n_r): rank's dense range is [start_r, start_r + n_r)."""
+        return self.rank_start[rank], self.rank_count[rank]
+
+    def experts_range(self, rank: int) -> tuple[int, int]:
+        """(experts_min, experts_max) for the HPU fused op, inclusive, in the dense id space."""
+        start, n = self.local_range(rank)
+        return start, start + n - 1
+
+    def local_to_global(self, rank: int) -> tuple[int, ...]:
+        """Global id held by each local weight slot of ``rank`` (slot i <-> dense id start_r + i)."""
+        start, n = self.local_range(rank)
+        return self.kept[start:start + n]
+
+    def expert_map(self, rank: int, device: torch.device | str = "cpu") -> torch.Tensor:
+        """vLLM expert_map for ``rank``: [num_experts] int32, local slot for kept experts of its slice, else -1.
+
+        Built on CPU by default (explicitly, not on the ambient default device) so the load-time comparison in
+        ``install_expert_drop`` stays a same-device ``torch.equal`` even if a loader keeps a device context open.
+        """
+        m = torch.full((self.num_experts, ), -1, dtype=torch.int32, device=device)
+        for slot, g in enumerate(self.local_to_global(rank)):
+            m[g] = slot
+        return m
+
+
+def expert_plan(layer_idx: int, ep_size: int, num_experts: int, dropped) -> ExpertDropPlan:
+    """Build the plan for one layer; raises ``ValueError`` when a rank would keep no expert.
+
+    ``VllmMixtureOfExpertsOp*`` builds one weight-list entry per local expert and
+    ``fp8_channel_moe_prepare_weights`` iterates over them, so an empty rank is unrepresentable: the JSON must
+    keep at least one expert in every rank's slice of every listed layer.
+    """
+    dropped = tuple(sorted(set(int(i) for i in dropped)))
+    if ep_size < 1:
+        raise ValueError(f"expert drop: ep_size must be >= 1, got {ep_size}")
+    if any(i < 0 or i >= num_experts for i in dropped):
+        raise ValueError(f"expert drop: layer {layer_idx}: ids must lie in [0, {num_experts}), got {dropped}")
+    dropped_set = set(dropped)
+    kept = tuple(g for g in range(num_experts) if g not in dropped_set)
+    slices = _linear_slices(num_experts, ep_size)
+    counts, starts, start = [], [], 0
+    for r, (lo, hi) in enumerate(slices):
+        n_r = sum(1 for g in kept if lo <= g < hi)
+        if n_r == 0:
+            raise ValueError(f"expert drop: layer {layer_idx}: rank {r} (global experts [{lo}, {hi})) would keep 0 "
+                             "experts; the fused op cannot represent an empty rank, keep at least one per rank")
+        starts.append(start)
+        counts.append(n_r)
+        start += n_r
+    plan = ExpertDropPlan(int(layer_idx), int(num_experts), int(ep_size), dropped, kept, tuple(slices),
+                          tuple(starts), tuple(counts))
+    # Contiguity by construction: kept is ascending and the slices are ascending in rank, so the dense ids of
+    # rank r's kept experts are exactly [start_r, start_r + n_r). Check it once rather than trust the argument.
+    g2d = plan.global_to_dense()
+    for r, (lo, hi) in enumerate(slices):
+        ds = [g2d[g] for g in range(lo, hi) if g not in dropped_set]
+        assert ds == list(range(starts[r], starts[r] + counts[r])), (r, ds)
+    return plan
+
+
+@functools.lru_cache(maxsize=256)
+def _cached_plan(path: str, layer_idx: int, ep_size: int, num_experts: int) -> ExpertDropPlan | None:
+    dropped = load_expert_mask_spec(path).get(layer_idx)
+    if not dropped:
+        return None
+    return expert_plan(layer_idx, ep_size, num_experts, dropped)
+
+
+def expert_drop_plan_for(layer_name: str | None, ep_size: int, num_experts: int) -> ExpertDropPlan | None:
+    """The layer's plan, or None when the drop is off or the layer is not listed (left dense, e.g. MTP 45)."""
+    path = reconcile_drop_env()
+    if not path:
+        return None
+    layer_idx = layer_index_from_name(layer_name)
+    if layer_idx is None:
+        return None
+    return _cached_plan(path, layer_idx, int(ep_size), int(num_experts))
+
+
+def expert_map_override(layer_name: str | None, ep_size: int, ep_rank: int,
+                        global_num_experts: int) -> tuple[int, torch.Tensor] | None:
+    """vLLM ``ExpertMapManager`` hook (patch 64): this rank's (local_num_experts, expert_map) for a dropped layer.
+
+    Returning None keeps vLLM's standard placement, so with the env var unset nothing changes.
+    """
+    plan = expert_drop_plan_for(layer_name, ep_size, global_num_experts)
+    if plan is None:
+        return None
+    start, n_r = plan.local_range(ep_rank)
+    lo, hi = plan.rank_slice[ep_rank]
+    # print, not logger: logger.info from these modules does not reach the serve log.
+    print(f"[EXPERT-DROP] layer {plan.layer_idx} rank {ep_rank}: keeps {n_r} of {hi - lo} local "
+          f"(dense [{start}, {start + n_r})), global kept {plan.num_kept} of {plan.num_experts}",
+          file=sys.stderr, flush=True)
+    return n_r, plan.expert_map(ep_rank)
+
+
+def _register_override() -> bool:
+    try:
+        from vllm.model_executor.layers.fused_moe.expert_map_manager import set_expert_map_override
+    except ImportError:  # vLLM tree without patch 64: install_expert_drop fails loud if a drop is requested
+        return False
+    set_expert_map_override(expert_map_override)
+    return True
+
+
+_OVERRIDE_REGISTERED = _register_override()
+
+
+def moe_op_expert_args(layer: torch.nn.Module) -> tuple[int, int, int, int]:
+    """(global_num_experts, num_experts, experts_min, experts_max) for building the HPU fused MoE op.
+
+    Without a drop plan this is the stock ``ep_rank * local_num_experts`` contiguous range over the true global
+    count. With a plan the op lives in the dense kept-id space: ``|kept|`` experts globally, ``n_r`` locally at
+    ``[start_r, start_r + n_r - 1]``.
+    """
+    num_experts = int(layer.local_num_experts)
+    ep_rank = int(layer.moe_config.ep_rank)
+    plan = expert_drop_plan_for(getattr(layer, "layer_name", None), layer.moe_config.ep_size,
+                                layer.global_num_experts)
+    if plan is None:
+        ep_shift = ep_rank * num_experts
+        return int(layer.global_num_experts), num_experts, ep_shift, ep_shift + num_experts - 1
+    start, n_r = plan.local_range(ep_rank)
+    if num_experts != n_r:
+        raise RuntimeError(f"{EXPERT_DROP_ENV}: layer {plan.layer_idx} rank {ep_rank}: local_num_experts is "
+                           f"{num_experts} but the plan keeps {n_r}; the vLLM tree did not apply the expert-map "
+                           f"override (patch 64 missing or set_expert_map_override not reached; "
+                           f"registered={_OVERRIDE_REGISTERED})")
+    return plan.num_kept, n_r, start, start + n_r - 1
+
+
+def assert_no_expert_drop(layer: torch.nn.Module, method: str) -> None:
+    """MoE methods that neither install the mask nor remap ids must refuse a drop instead of misrouting."""
+    if expert_drop_plan_for(getattr(layer, "layer_name", None), layer.moe_config.ep_size,
+                            layer.global_num_experts) is not None:
+        raise RuntimeError(f"{EXPERT_DROP_ENV}: {method} is not wired for the physical expert drop "
+                           f"(layer {getattr(layer, 'layer_name', '?')})")
+
+
+def local_expert_offset(layer: torch.nn.Module) -> int:
+    """First routing id (dense under a drop, global otherwise) owned by this rank; forward-time helper."""
+    plan = getattr(layer, EXPERT_DROP_PLAN_ATTR, None)
+    if plan is not None:
+        return int(plan.rank_start[int(layer.moe_config.ep_rank)])
+    return int(layer.moe_config.ep_rank * layer.local_num_experts)
+
+
+def install_expert_drop(layer: torch.nn.Module) -> torch.Tensor | None:
+    """Attach ``layer.glm53_dense_ids`` (buffer or None) and verify the layer matches its plan.
+
+    Call after ``install_expert_mask`` and after ``layer.moe_op`` is built. Checks, all fail-loud:
+    the vLLM side allocated exactly ``n_r`` expert rows (patch 64 applied), the mask drops exactly the plan's
+    experts (routing guarantee), the op's expert range is the plan's dense range, and the routing goes through
+    the grouped-top-k path that applies mask and remap. Also hands the op the inverse table so the patch-61
+    histogram keeps counting global ids.
+    """
+    layer.__dict__.pop(EXPERT_DENSE_ATTR, None)
+    layer._buffers.pop(EXPERT_DENSE_ATTR, None)
+    plan = expert_drop_plan_for(getattr(layer, "layer_name", None), layer.moe_config.ep_size,
+                                layer.global_num_experts)
+    setattr(layer, EXPERT_DROP_PLAN_ATTR, plan)
+    if plan is None:
+        layer.register_buffer(EXPERT_DENSE_ATTR, None, persistent=False)
+        return None
+
+    ep_rank = int(layer.moe_config.ep_rank)
+    start, n_r = plan.local_range(ep_rank)
+    tag = f"{EXPERT_DROP_ENV}: layer {plan.layer_idx} rank {ep_rank}"
+    if int(layer.local_num_experts) != n_r:
+        raise RuntimeError(f"{tag}: local_num_experts {layer.local_num_experts} != planned {n_r} (patch 64 not "
+                           f"applied; registered={_OVERRIDE_REGISTERED})")
+    for name in ("w13_weight", "w2_weight"):
+        w = getattr(layer, name, None)
+        if isinstance(w, torch.Tensor) and w.dim() > 0 and w.shape[0] not in (0, n_r):
+            raise RuntimeError(f"{tag}: {name} has {w.shape[0]} expert rows, planned {n_r}")
+    expert_map = getattr(layer, "expert_map", None)
+    if expert_map is not None:
+        if not torch.equal(expert_map.detach().to("cpu", torch.int32), plan.expert_map(ep_rank, device="cpu")):
+            raise RuntimeError(f"{tag}: layer.expert_map does not match the plan")
+    if not getattr(layer, "use_grouped_topk", False):
+        raise RuntimeError(f"{tag}: the drop needs the grouped-top-k routing path (mask + remap)")
+    mask = getattr(layer, EXPERT_MASK_ATTR, None)
+    if mask is None:
+        raise RuntimeError(f"{tag}: runtime mask not installed; the drop requires the mask from the same file")
+    masked = tuple(int(i) for i in (mask.detach().to("cpu") != 0).nonzero().flatten().tolist())
+    if masked != plan.dropped:
+        raise RuntimeError(f"{tag}: mask drops {masked} but the plan drops {plan.dropped}")
+
+    op = getattr(layer, "moe_op", None)
+    if op is not None:
+        want = (n_r, start, start + n_r - 1)
+        got = (int(op.num_experts), int(op.experts_min), int(op.experts_max))
+        if got != want:
+            raise RuntimeError(f"{tag}: moe_op (num_experts, experts_min, experts_max) {got} != planned {want}")
+        gne = getattr(op, "global_num_experts", None)
+        if gne is not None and int(gne) != plan.num_kept:
+            raise RuntimeError(f"{tag}: moe_op.global_num_experts {gne} != kept {plan.num_kept}")
+        # MAX_EXPERTS_PER_SLICE > 0 makes VllmMixtureOfExpertsOpBase slice the expert list into
+        # num_experts // moe_n_slice groups and silently skip the remainder; n_r is not uniform under a drop,
+        # so refuse any slicing that would not cover every kept expert.
+        n_slice = int(getattr(op, "moe_n_slice", 1) or 1)
+        per_group = int(getattr(op, "num_expert_per_group", n_r) or n_r)
+        if n_slice * per_group != n_r:
+            raise RuntimeError(f"{tag}: moe_op slicing (MAX_EXPERTS_PER_SLICE) covers {n_slice} x {per_group} "
+                               f"experts but the rank keeps {n_r}; unset MAX_EXPERTS_PER_SLICE or make every n_r "
+                               "divisible by the slice count")
+        inverse = torch.tensor(plan.dense_to_global(), dtype=torch.int64, device=_layer_device(layer))
+        if isinstance(op, torch.nn.Module):  # a buffer follows model.to(device); a plain attribute would not
+            op.__dict__.pop(EXPERT_DROP_INVERSE_ATTR, None)
+            op._buffers.pop(EXPERT_DROP_INVERSE_ATTR, None)
+            op.register_buffer(EXPERT_DROP_INVERSE_ATTR, inverse, persistent=False)
+        else:
+            setattr(op, EXPERT_DROP_INVERSE_ATTR, inverse)
+        setattr(op, EXPERT_DROP_HIST_WIDTH_ATTR, plan.num_experts)
+
+    dense = torch.tensor(plan.global_to_dense(), dtype=torch.int64, device=_layer_device(layer))
+    layer.register_buffer(EXPERT_DENSE_ATTR, dense, persistent=False)
+    return dense
