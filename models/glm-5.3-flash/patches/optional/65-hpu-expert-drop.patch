+
+
+def _route(seed, dropped, tokens=256):
+    """Real grouped_topk with the runtime mask: global ids over the kept set only, like the HPU path."""
+    g = torch.Generator().manual_seed(seed)
+    hidden = torch.randn(tokens, 16, generator=g)
+    logits = torch.randn(tokens, E, generator=g) * 2.0
+    bias = torch.randn(E, generator=g) * 0.1
+    mask = em.build_expert_mask(dropped, E, K)
+    w, ids = grouped_topk(hidden, logits, K, True, num_expert_group=1, topk_group=1, scoring_func="sigmoid",
+                          routed_scaling_factor=RSF, e_score_correction_bias=bias, expert_mask=mask)
+    assert ids.dtype == torch.int32 and not torch.isin(ids, torch.tensor(dropped)).any()
+    return w, ids
+
+
+def test_remap_and_localize_consistency_over_ranks():
+    """For random routing over kept ids, every rank's local slot holds the right global expert, once."""
+    plan = em.expert_plan(17, EP, E, _L17_DROPPED)
+    dense_table = torch.tensor(plan.global_to_dense(), dtype=torch.int64)
+    localize = ops["_localize_routing_ids"]
+    for seed in range(3):
+        _, gids = _route(seed, _L17_DROPPED)
+        dense = dense_table[gids.long()]  # the select_experts_from_routed remap
+        assert dense.shape == gids.shape and dense.dtype == torch.int64 and (dense < plan.num_kept).all()
+        covered = torch.zeros_like(gids, dtype=torch.int64)
+        for r in range(EP):
+            emin, emax = plan.experts_range(r)
+            local, lo, hi = localize(dense, emin, emax, plan.num_kept)
+            n = plan.rank_count[r]
+            loc2glob = torch.tensor(plan.local_to_global(r))
+            slice_lo, slice_hi = plan.rank_slice[r]
+            mine = (gids >= slice_lo) & (gids < slice_hi)
+            if emin == 0:  # rank 0: early return, raw dense ids, kernel bounds by experts_max
+                assert (lo, hi) == (0, emax) and torch.equal(local, dense)
+                assert (local[mine] <= emax).all() and (local[~mine] > emax).all()
+            else:
+                assert (lo, hi) == (0, n - 1)
+                assert (local[~mine] == plan.num_kept).all()  # non-local -> sentinel above every range
+                assert (local[mine] < n).all()
+            # the local slot each rank computes holds the right global expert
+            slots = local[mine]
+            assert torch.equal(loc2glob[slots], gids[mine].long())
+            assert torch.equal(plan.expert_map(r)[gids[mine].long()].long(), slots)  # == vLLM loader slot
+            covered[mine] += 1
+        assert (covered == 1).all()  # every routed slot is served by exactly one rank
+
+
+def test_histogram_counts_global_ids_under_the_drop():
+    plan = em.expert_plan(17, EP, E, _L17_DROPPED)
+    count, rh = ops["_route_hist_count"], ops["ROUTE_HIST"]
+    dense_table = torch.tensor(plan.global_to_dense(), dtype=torch.int64)
+    _, gids = _route(7, _L17_DROPPED, tokens=128)
+    dense = dense_table[gids.long()]
+    inverse = torch.tensor(plan.dense_to_global(), dtype=torch.int64)
+    expect = torch.bincount(gids.reshape(-1).long(), minlength=E)
+    rh.update({"enabled": True, "phase": 0, "row_mask": None, "tokens": None})
+    try:
+        # dropped layer: op in the dense space (global_num_experts == |kept|) + inverse table -> global counts
+        op = _FakeOp(plan.num_kept, plan.rank_count[0], 0, plan.rank_count[0] - 1)
+        op.register_buffer(em.EXPERT_DROP_INVERSE_ATTR, inverse, persistent=False)
+        setattr(op, em.EXPERT_DROP_HIST_WIDTH_ATTR, E)
+        count(op, dense)
+        assert op._route_hist.shape == (2, E + 1) and op._route_hist_width == E
+        assert torch.equal(op._route_hist[0, :E], expect) and op._route_hist[0, E] == 0
+        assert (op._route_hist[0, _L17_DROPPED] == 0).all() and op._route_hist[1].sum() == 0
+        # a (mask-prevented) sentinel id lands in the overflow bin, never in a real expert's bin
+        rh["phase"] = 1
+        count(op, torch.full((4, K), plan.sentinel, dtype=torch.int64))
+        assert op._route_hist[1, E] == 4 * K and op._route_hist[1, :E].sum() == 0
+        # row_mask still restricts to real rows
+        rh["phase"] = 0
+        rh["row_mask"] = torch.zeros(gids.shape[0], dtype=torch.bool)
+        count(op, dense)
+        assert torch.equal(op._route_hist[0, :E], expect)
+        rh["row_mask"] = None
+        # undropped layer: unchanged patch-61 behaviour (global ids, 288 wide, no overflow bin)
+        op2 = _FakeOp(E, 36, 36, 71)
+        count(op2, gids)
+        assert op2._route_hist.shape == (2, E) and torch.equal(op2._route_hist[0], expect)
+        assert op2._route_hist_width == E
+    finally:
+        rh.update({"enabled": False, "phase": 0, "row_mask": None, "tokens": None})
+
+
+if __name__ == "__main__":
+    tests = [(n, f) for n, f in sorted(globals().items()) if n.startswith("test_") and callable(f)]
+    for name, fn in tests:
+        fn()
+        print(f"PASS {name}")
+    print(f"{len(tests)} tests passed")
