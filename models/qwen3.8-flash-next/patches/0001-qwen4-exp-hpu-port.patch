+# ---------------------------------------------------------------------------
+# PLE (n-gram) layer
+# ---------------------------------------------------------------------------
+class HpuNgramTable(nn.Module):
+    """TP-sharded FP8 n-gram embedding table stored as raw uint8 with LUT dequant.
+
+    Gaudi2 interprets ``float8_e4m3fn`` bit patterns differently from CPU
+    (e4m3 *fnuz*), so instead of casting we keep the checkpoint bytes and
+    dequantize through a 256-entry lookup table computed on CPU.
+    """
+
+    def __init__(self, padded_vocab_size: int, head_dim: int, split_ngram_parts: int, org_vocab_size: int) -> None:
+        super().__init__()
+        self.tp_size = get_tensor_model_parallel_world_size()
+        self.tp_rank = get_tensor_model_parallel_rank()
+        self.padded_vocab_size = padded_vocab_size
+        self.org_vocab_size = org_vocab_size
+        self.head_dim = head_dim
+        self.split_ngram_parts = split_ngram_parts
+        assert padded_vocab_size % self.tp_size == 0
+        self.rows_per_rank = padded_vocab_size // self.tp_size
+        self.vocab_start = self.tp_rank * self.rows_per_rank
+        self.vocab_end = self.vocab_start + self.rows_per_rank
+        self.weight = nn.Parameter(torch.zeros(self.rows_per_rank, head_dim, dtype=torch.uint8), requires_grad=False)
+        self.weight_scale = nn.Parameter(torch.ones(1, dtype=torch.bfloat16), requires_grad=False)
+        # Build on CPU (torch semantics: 0x7F/0xFF = NaN -> 0). Built on HPU, those codes decode to +-inf.
+        lut = torch.arange(256, dtype=torch.uint8, device="cpu").view(torch.float8_e4m3fn).to(torch.float32)
+        lut = torch.nan_to_num(lut, nan=0.0, posinf=0.0, neginf=0.0)
+        self.register_buffer("lut", lut.to(torch.bfloat16), persistent=False)
+        self._loaded_rows = 0
+
+    def load_shard(self, shard_index: int, loaded_weight: torch.Tensor) -> None:
+        shard_size = (self.org_vocab_size + self.split_ngram_parts - 1) // self.split_ngram_parts
+        ckpt_start = shard_index * shard_size
+        ckpt_end = ckpt_start + loaded_weight.shape[0]
+        lo = max(ckpt_start, self.vocab_start)
+        hi = min(ckpt_end, self.vocab_end)
+        if lo >= hi:
+            return
+        src = loaded_weight[lo - ckpt_start:hi - ckpt_start]
+        if src.dtype != torch.uint8:
+            src = src.view(torch.uint8)
+        with torch.no_grad():
+            self.weight.data[lo - self.vocab_start:hi - self.vocab_start].copy_(src)
+        self._loaded_rows += hi - lo
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        """ids int32 [..., H] (global rows) -> bf16 [..., H*head_dim]"""
+        if self.tp_size > 1:
+            mask = (ids >= self.vocab_start) & (ids < self.vocab_end)
+            local = torch.where(mask, ids - self.vocab_start, torch.zeros_like(ids))
+        else:
+            mask = None
+            local = ids
+        flat = local.reshape(-1).long().clamp_(0, self.rows_per_rank - 1)
+        rows = self.weight.index_select(0, flat)  # [N, D] uint8
+        vals = self.lut.index_select(0, rows.reshape(-1).long().clamp_(0, 255)).reshape(rows.shape)  # bf16
+        vals = vals.reshape(*ids.shape, self.head_dim)
+        if mask is not None:
+            vals = vals * mask.unsqueeze(-1).to(vals.dtype)
+        vals = vals.flatten(-2)
+        if self.tp_size > 1:
+            vals = tensor_model_parallel_all_reduce(vals)
+        return vals * self.weight_scale.to(vals.dtype)
+
+
+class HpuQwen4ExpPLELayer(nn.Module, MambaBase):
+    """Position-Learning-Enhancement layer with n-gram embeddings and a dilated short conv.
+
+    Per-request state (kept in the hybrid Mamba cache, one compact slot per request):
+      * conv_state  [conv_state_len, hc_count*hidden]   (bf16)  previous ``normalized`` rows
+      * token_state [ngram_size-1]                       (int32) previous token ids (EOS-initialised)
+    """
+
+    def __init__(self, config: Qwen4ExpTextConfig, vllm_config: VllmConfig, layer_idx: int, ple_dense_layer_id: int,
+                 prefix: str) -> None:
+        super().__init__()
+        model_config = vllm_config.model_config
+        cache_config = vllm_config.cache_config
+        quant_config = vllm_config.quant_config
+        self.model_config = model_config
+        self.cache_config = cache_config
+        self.prefix = prefix
+        self.layer_idx = layer_idx
+        self.hidden_size = int(config.hidden_size)
+        self.hc_count = int(config.hc_count)
+        self.hc_hidden_size = self.hidden_size * self.hc_count
+        self.conv_kernel_size = int(config.ple_conv_kernel_size)
+        self.dilation = int(config.ngram_size)
+        self.conv_state_len = (self.conv_kernel_size - 1) * self.dilation
+        self.ngram_size = int(config.ngram_size)
+        self.heads_per_ngram = int(config.heads_per_ngram)
+        self.ngram_heads = (self.ngram_size - 1) * self.heads_per_ngram
+        self.ctx_len = self.ngram_size - 1
+        self.embed_dim = int(config.ple_embed_dim)
+        self.head_dim = self.embed_dim // self.ngram_heads
+        self.eos_token_id = int(config.eos_token_id)
+        self.dtype = model_config.dtype
+        self.cache_group_idx = None  # set by the HPU model runner
+
+        multipliers = make_layer_multipliers(ngram_size=self.ngram_size,
+                                             unigram_vocab_size=int(config.vocab_size),
+                                             seed=int(getattr(config, "seed", 1234)),
+                                             ple_dense_layer_id=ple_dense_layer_id)
+        sizes, offsets, total = make_vocab_layout(ngram_vocab_size_base=int(config.ngram_vocab_size_base),
+                                                  ngram_heads=self.ngram_heads,
+                                                  ple_dense_layer_id=ple_dense_layer_id)
+        # int64 values > 2**31 cannot live on HPU (lazy-mode init runs on device): keep as a Python list.
+        self._expected_multipliers = list(multipliers)
+        divisor = int(config.make_ngram_vocab_size_divisible_by)
+        padded_vocab = ((total + divisor - 1) // divisor) * divisor
+        self.hasher = NgramHasher(multipliers, sizes, offsets, self.heads_per_ngram, self.ngram_size)
+        self.ngram_table = HpuNgramTable(padded_vocab, self.head_dim, int(getattr(config, "split_ngram_parts", 512)),
+                                         total)
+
+        self.key_proj = ReplicatedLinear(self.embed_dim, self.hc_hidden_size, bias=False, quant_config=quant_config,
+                                         prefix=f"{prefix}.key_proj", return_bias=False)
+        self.value_proj = ReplicatedLinear(self.embed_dim, self.hidden_size, bias=False, quant_config=quant_config,
+                                           prefix=f"{prefix}.value_proj", return_bias=False)
+        self.norm_key = GroupedNorm(self.hc_hidden_size, config.rms_norm_eps, self.hidden_size, self.dtype)
+        self.norm_query = GroupedNorm(self.hc_hidden_size, config.rms_norm_eps, self.hidden_size, self.dtype)
+        self.norm_conv = GroupedNorm(self.hc_hidden_size, config.rms_norm_eps, self.hidden_size, self.dtype)
+        self.conv1d = nn.Conv1d(self.hc_hidden_size, self.hc_hidden_size, self.conv_kernel_size,
+                                groups=self.hc_hidden_size, bias=False, dtype=self.dtype)
+        nn.init.zeros_(self.conv1d.weight)
+        self.conv1d.weight._no_reinit = True
+        self.kv_cache = (torch.tensor([]), torch.tensor([]))
+        compilation_config = get_current_vllm_config().compilation_config
+        if prefix in compilation_config.static_forward_context:
+            raise ValueError(f"Duplicate layer name: {prefix}")
+        compilation_config.static_forward_context[prefix] = self
+
+    # --- MambaBase interface -------------------------------------------------
+    @property
+    def mamba_type(self) -> MambaAttentionBackendEnum:
+        return MambaAttentionBackendEnum.SHORT_CONV
+
+    @property
+    def is_kv_cache_tp_replicated(self) -> bool:
+        return True
+
+    def get_attn_backend(self):
+        from vllm.v1.attention.backends.short_conv_attn import ShortConvAttentionBackend
+        return ShortConvAttentionBackend
+
+    def get_state_dtype(self) -> tuple[torch.dtype, ...]:
+        return ple_state_dtypes(self.model_config.dtype)
+
+    def get_state_shape(self) -> Sequence[tuple[int, ...]]:
+        return ple_state_shapes(self.conv_state_len, self.hc_hidden_size, self.ctx_len)
+
+    # --- forward ---------------------------------------------------------------
+    def _state_indices(self, attn_metadata):
+        indices = attn_metadata.load_indices_tensor
+        if indices is not None and indices.dim() > 1:
+            cg = self.cache_group_idx
+            assert cg is not None, "cache_group_idx not set for PLE layer"
+            indices = indices.index_select(0, cg.view(1)).squeeze(0)
+        return indices
+
+    def _extract_metadata(self, input_ids: torch.Tensor, num_tokens: int):
+        """Extraction of forward-context metadata into plain tensors / ints (natural dynamo graph break)."""
+        attn_metadata = get_forward_context().attn_metadata
+        conv_state, tok_state = self.kv_cache[0], self.kv_cache[1]
+        have_state = attn_metadata is not None and conv_state.numel() > 0
+        is_prompt = bool(getattr(attn_metadata, "is_prompt", False)) if attn_metadata is not None else False
+        state_indices = self._state_indices(attn_metadata) if have_state else None
+        qsl = attn_metadata.query_start_loc_p if (have_state and is_prompt) else None
+        his = attn_metadata.has_initial_states_p if (have_state and is_prompt) else None
+        pm = getattr(attn_metadata, "padding_mask_flat", None) if (have_state and is_prompt) else None
+        if input_ids.dim() == 2:
+            B, L = int(input_ids.shape[0]), int(input_ids.shape[1])
+        else:
+            if qsl is not None:
+                B = int(qsl.numel()) - 1
+            elif state_indices is not None:
+                B = int(state_indices.numel())
+            else:
+                B = num_tokens
+            L = num_tokens // max(B, 1)
+        return (have_state, is_prompt, state_indices, conv_state, tok_state, qsl, his, pm, B, L)
+
+    def _conv_out(self, hist: torch.Tensor, length: int) -> torch.Tensor:
+        """hist [B, conv_state_len + length, C] -> silu(dilated depthwise conv) [B, length, C]"""
+        w = self.conv1d.weight.view(self.hc_hidden_size, self.conv_kernel_size).to(hist.dtype)
+        out = None
+        for k in range(self.conv_kernel_size):
+            term = hist[:, k * self.dilation:k * self.dilation + length, :] * w[:, k]
+            out = term if out is None else out + term
+        return F.silu(out)
+
+    def get_meta(self, input_ids: torch.Tensor):
+        """Resolve forward-context metadata for this layer EAGERLY (call outside compiled regions).
+
+        Tensors read from the global forward context inside a compiled region were baked as constants by
+        HPU torch.compile (per-request lengths / state slots of the first traced request were reused for
+        later requests → state written from padding). Passing them as explicit inputs avoids that.
+        """
+        return self._extract_metadata(input_ids, int(input_ids.numel()))
+
+    def forward(self, hidden_states: torch.Tensor, input_ids: torch.Tensor, state_writes: list | None = None,
+                meta=None) -> torch.Tensor:
+        orig_shape = hidden_states.shape
+        C = self.hc_hidden_size
+        h2 = hidden_states.reshape(-1, C)
+        num_tokens = h2.shape[0]
+        device = h2.device
+
+        if meta is None:
+            meta = self._extract_metadata(input_ids, num_tokens)
+        (have_state, is_prompt, state_indices, conv_state, tok_state, qsl, his, pm, B, L) = meta
+
+        tokens = input_ids.reshape(B, L).to(torch.int32)
+        eos = self.eos_token_id
+        pending = None
+
+        if have_state:
+            num_slots = conv_state.shape[0]
+            safe_idx = torch.remainder(state_indices, num_slots).long()
+            valid = (state_indices >= 0)
+            init_conv = conv_state.index_select(0, safe_idx)  # [B, S, C]
+            init_tok = tok_state.index_select(0, safe_idx)  # [B, 2]
+            if is_prompt:
+                if his is None:
+                    use_init = valid
+                else:
+                    if his.numel() < B:
+                        his = F.pad(his, (0, B - his.numel()), value=0)
+                    use_init = his[:B].bool() & valid
+            else:
+                use_init = valid
+            # NaN-safe masking (a stale NaN/Inf slot must not leak into a fresh request)
+            init_conv = torch.where(use_init.view(B, 1, 1), init_conv, torch.zeros_like(init_conv))
+            init_tok = torch.where(use_init.view(B, 1), init_tok, torch.full_like(init_tok, eos))
+        else:
+            init_conv = torch.zeros(B, self.conv_state_len, C, dtype=h2.dtype, device=device)
+            init_tok = torch.full((B, self.ctx_len), eos, dtype=torch.int32, device=device)
+
+        # ---- n-gram ids ---------------------------------------------------------
+        tokseq = torch.cat([init_tok, tokens], dim=1)  # [B, ctx+L]
+        t0 = tokseq[:, self.ctx_len:self.ctx_len + L]
+        t1 = tokseq[:, self.ctx_len - 1:self.ctx_len - 1 + L]
+        t2 = tokseq[:, self.ctx_len - 2:self.ctx_len - 2 + L]
+        eos_t = torch.full_like(t2, eos)
+        t2 = torch.where(t1 == eos, eos_t, t2)
+        t0 = torch.clamp(t0, min=0)  # padded rows may carry -1
+        ids = self.hasher(t0, t1, t2)  # [B, L, H] int32
+        emb = self.ngram_table(ids).reshape(num_tokens, self.embed_dim).to(h2.dtype)
+        if _DEBUG_DEEP: _dbg("ple.in", h2, state_indices, init_tok, init_conv, t0, t1, t2, ids, emb)
+        if _PLE_GRAPH_BREAKS:
+            # Deliberate graph break (partition proven correct when the un-broken region miscompiled).
+            torch._dynamo.graph_break()
+
+        # ---- gate / value ---------------------------------------------------------
+        key = self.key_proj(emb)
+        value = self.value_proj(emb)
+        key = self.norm_key(key).reshape(num_tokens, self.hc_count, self.hidden_size)
+        query = self.norm_query(h2).reshape(num_tokens, self.hc_count, self.hidden_size)
+        gate = (key * query).sum(dim=-1, keepdim=True) / math.sqrt(self.hidden_size)
+        gate = torch.sigmoid(gate.sign() * gate.abs().clamp_min(1e-6).sqrt())
+        gated_value = gate * value.unsqueeze(-2)  # [T, hc, H]
+        normalized = self.norm_conv(gated_value.flatten(-2))  # [T, C]
+
+        # ---- dilated short conv with state --------------------------------------
+        x = normalized.reshape(B, L, C)
+        hist = torch.cat([init_conv.to(x.dtype), x], dim=1)  # [B, S+L, C]
+        conv_out = self._conv_out(hist, L)  # [B, L, C]
+
+        if have_state and is_prompt:
+            if pm is not None and pm.numel() == num_tokens:
+                conv_out = conv_out * pm.view(B, L, 1).to(conv_out.dtype)
+            # Always eager: the in-graph length gather used the wrong index (see _save_state_prefill).
+            conv_out = _save_state_prefill(conv_out, conv_state, tok_state, state_indices, hist, tokseq, qsl,
+                                           B, self.conv_state_len, self.ctx_len)
+        elif have_state:
+            new_conv = hist[:, L:L + self.conv_state_len, :]
+            new_tok = tokseq[:, L:L + self.ctx_len]
+            upd = valid
+            new_conv = torch.where(upd.view(B, 1, 1), new_conv.to(conv_state.dtype), conv_state.index_select(0, safe_idx))
+            new_tok = torch.where(upd.view(B, 1), new_tok.to(tok_state.dtype), tok_state.index_select(0, safe_idx))
+            if _PLE_EAGER_STATE_WRITE or state_writes is None:
+                conv_out = _save_state(conv_out, conv_state, safe_idx, new_conv)
+                conv_out = _save_state(conv_out, tok_state, safe_idx, new_tok)
+                if _DEBUG_DEEP: _dbg("ple.readback", tok_state.index_select(0, safe_idx), conv_state.index_select(0, safe_idx))
+            else:
+                # Deferred: the caller applies these index_copy_ writes after the compiled region
+                # returns (in-graph index_put is silently mis-ordered/dropped by HPU torch.compile,
+                # and an eager write inside the region costs a graph break). The tensors are returned
+                # explicitly as graph outputs (list mutation inside the region is not relied upon).
+                pending = (safe_idx, new_conv.to(conv_state.dtype), new_tok.to(tok_state.dtype))
+
+        out = gated_value.flatten(-2) + conv_out.reshape(num_tokens, C)
+        if _DEBUG_DEEP: _dbg("ple.out", gate, gated_value, normalized, conv_out, out)
+        if _PLE_GRAPH_BREAKS:
+            torch._dynamo.graph_break()
+        if state_writes is not None:
+            return out.reshape(orig_shape), pending
+        return out.reshape(orig_shape)
+
+    # --- weights ---------------------------------------------------------------
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        loaded: set[str] = set()
+        regular: list[tuple[str, torch.Tensor]] = []
+        shard_prefix = "ple_embedding.ngram_embedding.shard_"
+        for name, w in weights:
+            leaf = name.rsplit(".", 1)[-1]
+            if leaf.startswith("hashstats_") or leaf == "token_lookup":
+                continue
+            if name == "ple_embedding.layer_multipliers":
+                got = w.to(torch.long).tolist()
+                if got != self._expected_multipliers:
+                    raise ValueError(f"PLE multipliers mismatch: ckpt {got} vs computed {self._expected_multipliers}")
+                loaded.add("layer_multipliers")
+                continue
+            if name in ("ple_embedding.ngram_heads_vocab_sizes", "ple_embedding.ngram_heads_offsets"):
+                continue
+            if name == "ple_embedding.ngram_embedding.weight_scale":
+                with torch.no_grad():
+                    self.ngram_table.weight_scale.data.copy_(w.reshape(1).to(torch.bfloat16))
+                loaded.add("ngram_table.weight_scale")
+                continue
+            if name.startswith(shard_prefix) and name.endswith(".weight"):
+                idx_text = name[len(shard_prefix):-len(".weight")]
+                if idx_text.isdigit():
+                    self.ngram_table.load_shard(int(idx_text), w)
+                    loaded.add("ngram_table.weight")
+                    continue
+            regular.append((name, w))
+        if regular:
+            loaded.update(AutoWeightsLoader(self).load_weights(regular))
+        return loaded
+
+
+def ple_state_dtypes(model_dtype: torch.dtype) -> tuple[torch.dtype, ...]:
+    return (model_dtype, torch.int32)
+
+
+def ple_state_shapes(conv_state_len: int, hc_hidden: int, ctx_len: int) -> tuple[tuple[int, ...], ...]:
+    return ((conv_state_len, hc_hidden), (ctx_len, ))
+
+
+# ---------------------------------------------------------------------------
+# Attention (dense fallback for QSA) with indexer weights kept loadable
+# ---------------------------------------------------------------------------
+class HpuQSAIndexerWeights(nn.Module):
+    """Holds the QSA indexer parameters so the checkpoint loads cleanly.
+
+    The sparse top-k selection itself is not executed on HPU (dense attention
+    is used); keeping the weights allows a future sparse implementation.
+    """
+
+    def __init__(self, config: Qwen4ExpTextConfig, quant_config, prefix: str) -> None:
+        super().__init__()
+        n_heads = int(config.indexer_n_heads)
+        kv_heads = int(config.indexer_kv_heads)
+        head_dim = int(config.indexer_head_dim)
+        self.index_qk_proj = ReplicatedLinear(int(config.hidden_size), (n_heads + kv_heads) * head_dim, bias=False,
+                                              quant_config=quant_config, prefix=f"{prefix}.index_qk_proj")
+        self.q_layernorm = GemmaRMSNorm(head_dim, eps=float(config.rms_norm_eps))
+        self.k_layernorm = GemmaRMSNorm(head_dim, eps=float(config.rms_norm_eps))
+
+
+# ---------------------------------------------------------------------------
+# Decoder layer
+# ---------------------------------------------------------------------------
+class HpuQwen4ExpSparseMoeBlock(Qwen3NextSparseMoeBlock):
+
+    def __init__(self, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__(vllm_config=vllm_config, prefix=prefix)
+        config = vllm_config.model_config.hf_text_config
+        self.n_shared_experts = int(config.shared_expert_intermediate_size > 0)
+
+
+class HpuQwen4ExpDecoderLayer(nn.Module):
+
+    def __init__(self, vllm_config: VllmConfig, layer_type: str, prefix: str = "") -> None:
+        super().__init__()
+        config: Qwen4ExpTextConfig = vllm_config.model_config.hf_text_config
+        model_config = vllm_config.model_config
+        cache_config = vllm_config.cache_config
+        quant_config = vllm_config.quant_config
+        self.config = config
+        self.layer_type = layer_type
+        self.layer_idx = extract_layer_index(prefix)
+        self.hc_count = int(config.hc_count)
+
+        self.ple: HpuQwen4ExpPLELayer | None = None
+        ple_layer_ids = sorted(set(int(i) for i in (config.ple_layer_ids or [])))
+        if (self.layer_idx + 1) in ple_layer_ids:
+            dense_id = ple_layer_ids.index(self.layer_idx + 1)
+            self.ple = HpuQwen4ExpPLELayer(config, vllm_config=vllm_config, layer_idx=self.layer_idx,
+                                           ple_dense_layer_id=dense_id, prefix=f"{prefix}.ple")
+
+        import contextlib
+        with (_tp1_context() if _DENSE_REPLICATED else contextlib.nullcontext()):
+            if layer_type == "linear_attention":
+                self.linear_attn = HPUGatedDeltaNetAttention(config, vllm_config=vllm_config,
+                                                             prefix=f"{prefix}.linear_attn",
+                                                             gqa_interleaved_layout=False)
+            elif layer_type == "full_attention":
+                self.self_attn = Qwen3NextAttention(config, model_config=model_config, cache_config=cache_config,
+                                                    quant_config=quant_config, prefix=f"{prefix}.self_attn")
+                if getattr(config, "indexer_n_heads", None) is not None:
+                    self.self_attn.indexer = HpuQSAIndexerWeights(config, quant_config,
+                                                                  prefix=f"{prefix}.self_attn.indexer")
+            else:
+                raise ValueError(f"Invalid layer_type {layer_type}")
+
+        mlp_only_layers = getattr(config, "mlp_only_layers", []) or []
+        num_experts = getattr(config, "num_experts", 0) or 0
+        sparse_step = getattr(config, "decoder_sparse_step", 1) or 1
+        is_moe = self.layer_idx not in mlp_only_layers and num_experts > 0 and (self.layer_idx + 1) % sparse_step == 0
+        if is_moe:
+            self.mlp = HpuQwen4ExpSparseMoeBlock(vllm_config=vllm_config, prefix=f"{prefix}.mlp")
+        else:
+            self.mlp = Qwen3NextMLP(hidden_size=config.hidden_size, intermediate_size=config.intermediate_size,
+                                    hidden_act=config.hidden_act, quant_config=quant_config, prefix=f"{prefix}.mlp")
+
+        hc_config = HyperConnectionConfig(hc_count=config.hc_count, hidden_size=config.hidden_size,
+                                          params_dtype=torch.bfloat16, hc_lowrank=config.hc_lowrank,
+                                          rms_norm_eps=config.rms_norm_eps, hc_per_branch_norm=True)
+        self.attn_hyper_connection = GatedResidual(hc_config)
+        self.mlp_hyper_connection = GatedResidual(hc_config)
+
+    def forward(self, hidden_states: torch.Tensor, positions: torch.Tensor,
+                input_ids: torch.Tensor | None, state_writes: list | None = None, ple_meta=None) -> torch.Tensor:
+        ple_writes = None
+        if self.ple is not None and not _ABL["PLE"]:
+            if input_ids is None:
+                raise RuntimeError("PLE layer requires raw input_ids")
+            if state_writes is not None:
+                ple_out, ple_writes = self.ple(hidden_states, input_ids, state_writes, ple_meta)
+            else:
+                ple_out = self.ple(hidden_states, input_ids, None, ple_meta)
+            hidden_states = hidden_states + ple_out
+
+        if _ABL["HC"]:  # plain residual on stream 0 (timing only)
+            x0 = hidden_states[..., :self.config.hidden_size]
+            if self.layer_type == "linear_attention":
+                a = x0 if _ABL["GDN"] else self.linear_attn(hidden_states=x0)
+            else:
+                a = x0 if _ABL["ATTN"] else self.self_attn(positions=positions, hidden_states=x0)
+            x0 = x0 + a
+            m = x0 if _ABL["MOE"] else self.mlp(x0)
+            x0 = x0 + m
+            out = torch.cat([x0] * self.hc_count, dim=-1)
+            return (out, ple_writes) if state_writes is not None else out
+
+        block_input, residuals = self.attn_hyper_connection.mix(hidden_states)
+        if _ABL["GDN"] and self.layer_type == "linear_attention":
+            attn_out = block_input
+        elif _ABL["ATTN"] and self.layer_type == "full_attention":
+            attn_out = block_input
+        elif self.layer_type == "linear_attention":
+            if _DEBUG_DEEP and self.layer_idx in (0, 1, 2):
+                kv = self.linear_attn.kv_cache
+                _dbg(f"gdn{self.layer_idx}.state", kv[0] if len(kv) else None, kv[1] if len(kv) > 1 else None, block_input)
+            attn_out = self.linear_attn(hidden_states=block_input)
+            if _DEBUG_DEEP and self.layer_idx in (0, 1, 2):
+                _dbg(f"gdn{self.layer_idx}.out", attn_out)
+        else:
+            attn_out = self.self_attn(positions=positions, hidden_states=block_input)
+        hidden_states = self.attn_hyper_connection.combine(attn_out, residuals)
+
+        block_input, residuals = self.mlp_hyper_connection.mix(hidden_states)
+        mlp_out = block_input if _ABL["MOE"] else self.mlp(block_input)
+        hidden_states = self.mlp_hyper_connection.combine(mlp_out, residuals)
+        if state_writes is not None:
+            return hidden_states, ple_writes
+        return hidden_states
+
+
+# ---------------------------------------------------------------------------
+# Model
+# ---------------------------------------------------------------------------
+class HpuQwen4ExpMixtureOfExperts(MixtureOfExperts):
+
+    def set_moe_parameters(self, layers: Iterable[nn.Module]) -> None:
+        self.moe_layers = []
+        self.moe_mlp_layers = []
+        example_moe = None
+        for layer in layers:
+            if isinstance(layer, HpuQwen4ExpDecoderLayer) and isinstance(layer.mlp, HpuQwen4ExpSparseMoeBlock):
+                example_moe = layer.mlp
+                self.moe_mlp_layers.append(layer.mlp)
+                self.moe_layers.append(layer.mlp.experts)
+        self.num_moe_layers = len(self.moe_layers)
+        if example_moe is None:
+            self.num_expert_groups = 0
+            self.num_shared_experts = 0
+            self.num_logical_experts = 0
+            self.num_physical_experts = 0
+            self.num_local_physical_experts = 0
+            self.num_routed_experts = 0
+            self.num_redundant_experts = 0
+            return
+        self.num_expert_groups = 1
+        self.num_shared_experts = example_moe.n_shared_experts
+        self.num_logical_experts = example_moe.n_logical_experts
+        self.num_physical_experts = example_moe.n_physical_experts
+        self.num_local_physical_experts = example_moe.n_local_physical_experts
+        self.num_routed_experts = example_moe.n_routed_experts
+        self.num_redundant_experts = example_moe.n_redundant_experts
+
+    def update_physical_experts_metadata(self, num_physical_experts: int, num_local_physical_experts: int) -> None:
+        assert self.num_local_physical_experts == num_local_physical_experts
+        self.num_physical_experts = num_physical_experts
+        self.num_local_physical_experts = num_local_physical_experts
+        self.num_redundant_experts = num_physical_experts - self.num_logical_experts
+        for moe in self.moe_mlp_layers:
+            moe.n_physical_experts = num_physical_experts
+            moe.n_local_physical_experts = num_local_physical_experts
+            moe.n_redundant_experts = self.num_redundant_experts
+            moe.experts.update_expert_map()
+
+
+class _LayerGroup(nn.Module):
+    """Runs a fixed list of decoder layers; compiled as one region (layers unregistered on purpose)."""
+
+    def __init__(self, layers: list) -> None:
+        super().__init__()
+        self._group_layers = layers
+
+    def forward(self, hidden_states, positions, input_ids, state_writes, ple_meta=None):
+        writes = []
+        for layer in self._group_layers:
+            hidden_states, w = layer(hidden_states, positions, input_ids, state_writes, ple_meta)
+            if w is not None:
+                writes.append(w)
+        return hidden_states, writes
+
+
+class HpuQwen4ExpModel(nn.Module):
+    hf_to_vllm_mapper = Qwen3_5Model.hf_to_vllm_mapper
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__()
+        config: Qwen4ExpTextConfig = vllm_config.model_config.hf_text_config
+        self.config = config
+        self.vocab_size = config.vocab_size
+        self.hc_count = int(config.hc_count)
+        self.embed_tokens = VocabParallelEmbedding(self.vocab_size, config.hidden_size)
+
+        def get_layer(prefix: str) -> HpuQwen4ExpDecoderLayer:
+            layer_idx = extract_layer_index(prefix)
+            return HpuQwen4ExpDecoderLayer(vllm_config, layer_type=config.layer_types[layer_idx], prefix=prefix)
+
+        self.start_layer, self.end_layer, self.layers = make_layers(config.num_hidden_layers, get_layer,
+                                                                    prefix=f"{prefix}.layers")
+        # Group consecutive layers into modules so the runner's regional compilation (one region per
+        # ModuleList child) compiles G layers as a single graph. Groups keep the layer modules in a plain
+        # list (unregistered) so parameter names / weight loading stay on ``self.layers``.
+        G = max(1, _LAYERS_PER_REGION)
+        real_layers = list(self.layers)[self.start_layer:self.end_layer]
+        self.layer_groups = nn.ModuleList(
+            [_LayerGroup(real_layers[i:i + G]) for i in range(0, len(real_layers), G)])
+        ple_layers = [l.ple for l in real_layers if getattr(l, "ple", None) is not None]
+        assert len(ple_layers) <= 1, "one PLE layer supported"
+        self._ple_layer = ple_layers[0] if ple_layers else None
+        self.make_empty_intermediate_tensors = make_empty_intermediate_tensors_factory(
+            ["hidden_states"], config.hidden_size * config.hc_count)
+        hc_config = HyperConnectionConfig(hc_count=config.hc_count, hidden_size=config.hidden_size,
+                                          params_dtype=torch.bfloat16, hc_lowrank=config.hc_lowrank,
+                                          rms_norm_eps=config.rms_norm_eps, hc_per_branch_norm=True)
+        self.hyper_connection_mixer = GatedResidual(hc_config, use_combine=False)
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.embed_tokens(input_ids)
+
+    def forward(self, input_ids: torch.Tensor | None, positions: torch.Tensor,
+                intermediate_tensors: IntermediateTensors | None = None,
+                inputs_embeds: torch.Tensor | None = None, **kwargs) -> torch.Tensor:
+        if inputs_embeds is not None:
+            hidden_states = inputs_embeds
+        else:
+            if input_ids is None:
+                raise ValueError("input_ids or inputs_embeds is required")
+            hidden_states = self.embed_input_ids(input_ids)
+        rep = [1] * (hidden_states.dim() - 1) + [self.hc_count]
+        hidden_states = hidden_states.repeat(*rep)
+        # Resolve PLE metadata eagerly (outside any compiled region) so lengths / state slots are graph inputs.
+        ple_meta = None
+        if self._ple_layer is not None and input_ids is not None:
+            ple_meta = self._ple_layer.get_meta(input_ids)
+
+        if _DEBUG:
+            _dbg("embed", hidden_states, input_ids)
+            md = get_forward_context().attn_metadata
+            _dbg("meta", getattr(md, "load_indices_tensor", None) if md is not None else None,
+                 getattr(md, "has_initial_states_p", None) if md is not None else None,
+                 getattr(md, "query_start_loc_p", None) if md is not None else None)
+            for li in (0, 1):
+                lyr = self.layers[li]
+                if getattr(lyr, "ple", None) is not None and len(lyr.ple.kv_cache) == 2:
+                    _dbg(f"state.ple{li}", lyr.ple.kv_cache[0], lyr.ple.kv_cache[1])
+                if hasattr(lyr, "linear_attn") and len(lyr.linear_attn.kv_cache) == 2:
+                    _dbg(f"state.gdn{li}", lyr.linear_attn.kv_cache[0], lyr.linear_attn.kv_cache[1])
+        if _DEBUG and _marker("QWEN4_DEBUG_GROUPS"):
+            # probes per group, keeping the production (grouped) execution path
+            for gi, group in enumerate(self.layer_groups):
+                hidden_states, _w = group(hidden_states, positions, input_ids, True, ple_meta)
+                _dbg_rows(f"group{gi}", hidden_states)
+        elif _DEBUG:
+            for i, layer in enumerate(islice(self.layers, self.start_layer, self.end_layer)):
+                hidden_states = layer(hidden_states, positions, input_ids, None, ple_meta)
+                if i < 4 or i % 8 == 7 or i == self.end_layer - 1:
+                    _dbg(f"layer{i}", hidden_states)
+        else:
+            for group in self.layer_groups:
+                hidden_states, writes = group(hidden_states, positions, input_ids, True, ple_meta)
+                for (idx, new_conv, new_tok), layer in zip(writes, [l for l in group._group_layers if l.ple is not None]):
+                    # eager, outside the compiled region
+                    layer.ple.kv_cache[0].index_copy_(0, idx, new_conv)
+                    layer.ple.kv_cache[1].index_copy_(0, idx, new_tok)
+
+        sample_hidden_states, _ = self.hyper_connection_mixer.mix(hidden_states)
+        if _DEBUG: _dbg("final", sample_hidden_states)
+        return sample_hidden_states
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        weights = maybe_fuse_shared_experts(weights, enabled=False,
+                                            n_routed_experts=getattr(self.config, "num_experts", 0) or 0,
+                                            n_shared_experts=1, ckpt_prefix="mlp.shared_expert")
+        skip_substrs = ("hashstats_", "token_lookup", "hyper_connection_mixer.block_inject_weight")
+        mapper = self.hf_to_vllm_mapper | WeightsMapper(orig_to_new_substr={s: None for s in skip_substrs})
+        loader = AutoWeightsLoader(self, ignore_unexpected_suffixes=_IGNORED_SUFFIXES.copy())
+        return loader.load_weights(weights, mapper=mapper)
+
