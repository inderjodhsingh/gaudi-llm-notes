+
+def configure_markers(model_dir: str | None) -> None:
+    """Re-resolve all marker-controlled switches for this launch (model dir first, then /work)."""
+    global _MARKER_DIRS, _DEBUG, _DEBUG_DEEP, _PLE_GRAPH_BREAKS, _PLE_EAGER_STATE_WRITE, _LAYERS_PER_REGION, _FAST_DECODE
+    global _DENSE_REPLICATED, _ABL
+    if model_dir and _os.path.isdir(model_dir):
+        _MARKER_DIRS = [model_dir] if any(f.startswith("QWEN4_") for f in _os.listdir(model_dir)) else ["/work"]
+    _DEBUG = _marker("QWEN4_DEBUG")
+    _DEBUG_DEEP = _marker("QWEN4_DEBUG_DEEP")
+    _PLE_GRAPH_BREAKS = _marker("QWEN4_PLE_GRAPH_BREAKS")
+    # Deferred writes (state tensors returned from the compiled region and written by the caller) give wrong
+    # results at batch >= 2 on HPU (rows of the second request corrupted); eager in-region writes are the default.
+    _PLE_EAGER_STATE_WRITE = not _marker("QWEN4_PLE_DEFERRED_WRITE")
+    _FAST_DECODE = _marker("QWEN4_FAST_DECODE")  # opt-in: no gated gain, crashes with per-layer frames at TP4
+    _LAYERS_PER_REGION = _marker_int("QWEN4_LAYERS_PER_REGION", 1)
+    _DENSE_REPLICATED = _marker("QWEN4_DENSE_REPLICATED")
+    _ABL = {k: _marker(f"QWEN4_ABL_NO_{k}") for k in ("MOE", "GDN", "ATTN", "HC", "PLE")}
+    import sys as _sys
+    print(f"[QWEN4] markers from {_MARKER_DIRS}: debug={_DEBUG} deep={_DEBUG_DEEP} ple_breaks={_PLE_GRAPH_BREAKS} "
+          f"eager_write={_PLE_EAGER_STATE_WRITE} fast_decode={_FAST_DECODE} layers_per_region={_LAYERS_PER_REGION} dense={_DENSE_REPLICATED} "
+          f"abl={_ABL}", file=_sys.stderr, flush=True)
+
+
+_DEBUG = _os.path.exists("/work/QWEN4_DEBUG")  # file flag: env vars do not reach HPU workers
+_DEBUG_DEEP = _os.path.exists("/work/QWEN4_DEBUG_DEEP")
+# Tunables via marker files (env vars do not reach HPU workers): see docs/05_PERF.md
+_PLE_GRAPH_BREAKS = _os.path.exists("/work/QWEN4_PLE_GRAPH_BREAKS")
+_PLE_EAGER_STATE_WRITE = not _os.path.exists("/work/QWEN4_PLE_DEFERRED_WRITE")
+_FAST_DECODE = _os.path.exists("/work/QWEN4_FAST_DECODE")
+_LAYERS_PER_REGION = int(open("/work/QWEN4_LAYERS_PER_REGION").read().strip()) if _os.path.exists("/work/QWEN4_LAYERS_PER_REGION") else 1
+# Dense-replicated mode: build every non-expert module with TP=1 semantics (full weights on every rank,
+# no per-layer all-reduce for attention/GDN); only the routed experts stay sharded (EP) with one
+# all-reduce per MoE layer. Costs ~+4.5 GB weights per rank at TP4; removes ~48 collectives per step.
+_DENSE_REPLICATED = _os.path.exists("/work/QWEN4_DENSE_REPLICATED")
+
+
+class _tp1_context:
+    """Temporarily make the TP-size/rank helpers report (1, 0) in the modules that build dense layers."""
+    _targets = ("vllm.model_executor.layers.linear", "vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn",
+                "vllm.model_executor.layers.mamba.gdn.base", "vllm.model_executor.layers.attention.attention",
+                "vllm.model_executor.models.qwen3_next", "vllm.model_executor.layers.mamba.abstract",
+                "vllm.model_executor.layers.layernorm", "vllm_gaudi.models.qwen3_5", "vllm.distributed",
+                "vllm.distributed.parallel_state")
+
+    def __init__(self, targets=None):
+        self._targets_override = targets
+
+    def __enter__(self):
+        import importlib
+        self._saved = []
+        for name in (self._targets_override or self._targets):
+            try:
+                mod = importlib.import_module(name)
+            except Exception:
+                continue
+            for fn, val in (("get_tensor_model_parallel_world_size", 1), ("get_tensor_model_parallel_rank", 0)):
+                if hasattr(mod, fn):
+                    self._saved.append((mod, fn, getattr(mod, fn)))
+                    setattr(mod, fn, (lambda v=val: v))
+        return self
+
+    def __exit__(self, *a):
+        for mod, fn, orig in self._saved:
+            setattr(mod, fn, orig)
+        return False
+
+
+def _load_ctx():
+    """During weight loading, sharded_weight_loader (GDN A_log/dt_bias/conv) reads the TP rank at call time."""
+    import contextlib
+    if not _DENSE_REPLICATED:
+        return contextlib.nullcontext()
+    return _tp1_context(targets=("vllm.model_executor.model_loader.weight_utils",
+                                 "vllm.model_executor.layers.mamba.mamba_mixer2"))
+
+
+# Ablation switches for timing experiments only (outputs are garbage when set)
+_ABL = {k: _os.path.exists(f"/work/QWEN4_ABL_NO_{k}") for k in ("MOE", "GDN", "ATTN", "HC", "PLE")}
+if any(_ABL.values()):
+    import sys as _sys
+    print(f"[QWEN4] ABLATION active: {_ABL}", file=_sys.stderr, flush=True)
+if _DEBUG:
+    import sys as _sys
+    print(f"[QWEN4_DEBUG] probes enabled at import (pid {_os.getpid()})", file=_sys.stderr, flush=True)
+if not _os.path.exists("/work/QWEN4_NO_FAST_TOPK"):
+    from vllm_gaudi.ops.hpu_topk_topp import install as _install_fast_topk
+    _install_fast_topk()
+if _os.path.exists("/work/QWEN4_DEBUG_GB"):
+    torch._logging.set_logs(graph_breaks=True, recompiles=True)
+
+
+@torch._dynamo.disable
+def _dbg(tag: str, *tensors) -> None:
+    """NaN/absmax probe (QWEN4_DEBUG=1), rank 0 only, eager."""
+    if not _DEBUG:
+        return
+    try:
+        if get_tensor_model_parallel_rank() != 0:
+            return
+    except Exception:
+        pass
+    parts = []
+    for t in tensors:
+        if t is None or not isinstance(t, torch.Tensor) or t.numel() == 0:
+            parts.append("None")
+            continue
+        tf = t.detach()
+        if tf.is_floating_point():
+            parts.append(f"nan={int(torch.isnan(tf).sum())} inf={int(torch.isinf(tf).sum())} absmax={float(tf.abs().max()):.3g} shape={tuple(tf.shape)}")
+        else:
+            parts.append(f"min={int(tf.min())} max={int(tf.max())} shape={tuple(tf.shape)} vals={tf.flatten()[:8].tolist()}")
+    import sys as _sys
+    print("[QWEN4_DEBUG] " + tag + ": " + " | ".join(parts), file=_sys.stderr, flush=True)
+
+_IGNORED_SUFFIXES = [".bias", "_bias", ".k_scale", "_k_scale", ".v_scale", "_v_scale", "_weight_scale", "_input_scale"]
+
