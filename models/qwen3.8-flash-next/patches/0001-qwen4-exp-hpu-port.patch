+# Marker files control debug/tuning switches (env vars do not reach HPU workers). A marker is looked up
+# first in the model directory (so side experiments on other checkpoints never affect a real launch), then
+# under /work. ``configure_markers(model_dir)`` is called at model construction; module-level defaults come
+# from /work only.
+_MARKER_DIRS: list = ["/work"]
+
+
+def _marker(name: str) -> bool:
+    return any(_os.path.exists(_os.path.join(d, name)) for d in _MARKER_DIRS)
+
+
+def _marker_int(name: str, default: int) -> int:
+    for d in _MARKER_DIRS:
+        f = _os.path.join(d, name)
+        if _os.path.exists(f):
+            return int(open(f).read().strip())
+    return default
