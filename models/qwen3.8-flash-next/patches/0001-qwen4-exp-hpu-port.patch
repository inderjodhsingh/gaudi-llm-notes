+class _LayerGroup(nn.Module):
+    """Runs a fixed list of decoder layers; compiled as one region (layers unregistered on purpose)."""
+
+    def __init__(self, layers: list) -> None:
+        super().__init__()
+        self._group_layers = layers
+        # unrolled forward from a real source file (see qwen4_exp_groups.py); marker QWEN4_LOOP_GROUPS restores
+        # the looped variant (bisecting only)
+        if _marker("QWEN4_UNROLLED_GROUPS"):  # opt-in: fused regions are slower unless collectives stay in-graph
+            self.forward = types.MethodType(_GROUP_FORWARDS[len(layers)], self)
+
+    def forward(self, hidden_states, positions, input_ids, state_writes, ple_meta=None, gdn_slots=None,
+                prev_writes=None):
+        if prev_writes:
+            for (state, idx, val) in prev_writes:
+                state.index_copy_(0, idx, val)
+        writes = []
+        if gdn_slots is None:
+            # default (reference) path: exactly the pre-fast-path structure — the layer is called directly (an extra
+            # `_call_layer` frame per layer cost ~15% at TP4: try56 31.6 vs try57 37.0 tok/s)
+            for layer in self._group_layers:
+                hidden_states, w = layer(hidden_states, positions, input_ids, state_writes, ple_meta)
+                if w:
+                    writes.extend(w)
+            return hidden_states, writes
+        for i in range(len(self._group_layers)):
+            hidden_states, w = self._call_layer(i, hidden_states, positions, input_ids, state_writes, ple_meta, gdn_slots)
+            if w:
+                writes.extend(w)
+        return hidden_states, writes
+
+    def _call_layer(self, i, hidden_states, positions, input_ids, state_writes, ple_meta, gdn_slots):
+        layer = self._group_layers[i]
+        if gdn_slots is not None and layer.layer_type == "linear_attention":
+            return layer(hidden_states, positions, input_ids, state_writes, ple_meta,
+                         gdn_slots=gdn_slots[layer._gdn_ordinal])
+        return layer(hidden_states, positions, input_ids, state_writes, ple_meta)
+
+
+class _CommitRegion(nn.Module):
+    """Applies the last region's pending state writes (compiled as its own region)."""
+
+    def forward(self, hidden_states, writes):
+        for (state, idx, val) in writes:
+            state.index_copy_(0, idx, val)
+        return hidden_states
+
